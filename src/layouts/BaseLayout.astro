---
import "@/styles/global.css";
import BaseHead from "@/components/BaseHead.astro";
import { ClientRouter } from "astro:transitions";
import LanguagePicker from "@/components/LanguagePicker.astro";

interface Props {
    title: string;
    id?: string;
    showLanguagePicker?: boolean;
}

const { title, id, showLanguagePicker = false } = Astro.props;
---

<!doctype html>
<html lang="en" class="jakarta text-[var(--text-color)] scroll-smooth selection:bg-accent">
    <head>
        <BaseHead title={title} />
        <ClientRouter />
    </head>
    <body id={id} class="bg-[#f2f0eb] flex flex-col min-h-svh h-auto relative">
        {showLanguagePicker && (
            <div class="absolute top-4 right-4 z-50">
                <LanguagePicker />
            </div>
        )}
        <main class="grow">
            <slot />
        </main>
    </body>
</html>
