---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, getLocalizedPath, useTranslations } from "@/i18n/utils";

interface Props {
    iconStateMap?: string;
    iconStateHome?: string;
    iconStateUser?: string;
}

const { iconStateMap = "", iconStateHome = "", iconStateUser = "" } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<nav aria-label="Main navigation" class="fixed bottom-0 left-0 right-0 z-40 bg-[#f2f0eb]/95 dark:bg-[#121712]/95 backdrop-blur-md border-t border-neutral-200/70 dark:border-neutral-800 pt-2.5 px-6 flex justify-around items-center max-w-lg mx-auto md:max-w-2xl rounded-t-2xl shadow-lg" style="padding-bottom: max(0.75rem, calc(0.5rem + env(safe-area-inset-bottom, 0px)));">
    <!-- 1. Map -->
    <a aria-label={t('nav.map')} href={getLocalizedPath('/authenticated/map', lang)} class={`p-1.5 ${iconStateMap} rounded-xl transition-all duration-200 hover:scale-105 active:scale-95 flex flex-col items-center gap-0.5`}>
        <Icon name="map" class="w-6.5 h-6.5" />
    </a>

    <!-- 2. Trips -->
    <a aria-label={t('nav.trips')} href={getLocalizedPath('/authenticated/trips', lang)} class={`p-1.5 ${iconStateHome} rounded-xl transition-all duration-200 hover:scale-105 active:scale-95 flex flex-col items-center gap-0.5`}>
        <Icon name="home" class="w-6.5 h-6.5" />
    </a>

    <!-- 3. Profile / Settings -->
    <a aria-label={t('nav.profile')} href={getLocalizedPath('/authenticated/', lang)} class={`p-1.5 ${iconStateUser} rounded-xl transition-all duration-200 hover:scale-105 active:scale-95 flex flex-col items-center gap-0.5`}>
        <Icon name="user" class="w-6.5 h-6.5" />
    </a>
</nav>
