---
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogFooter, DialogClose } from "@/components/starwind/dialog";
import { Button } from "@/components/starwind/button";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
    uid: string;
    tripID: string;
}

const { uid, tripID } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Dialog id="trip-share-dialog">
    <DialogContent class="w-9/10 max-w-md rounded-2xl p-6">
        <div id="trip-share-wrapper" data-uid={uid} data-trip-id={tripID} class="flex flex-col gap-4">
            <DialogHeader>
                <DialogTitle class="text-xl font-bold text-[#121712] dark:text-white flex items-center gap-2">
                    <Icon name="share" class="w-5 h-5 text-[#63875e]" />
                    <span>{t('share.modalTitle')}</span>
                </DialogTitle>
            </DialogHeader>

            <p class="text-xs text-[var(--lt-text-color)] leading-relaxed">
                {t('share.explanation')}
            </p>

            <!-- Loading State -->
            <div id="share-loading" class="flex flex-col items-center justify-center py-6 gap-2">
                <div class="w-6 h-6 border-2 border-[#63875e] border-t-transparent rounded-full animate-spin"></div>
                <span class="text-xs text-[var(--lt-text-color)]">{t('share.checking')}</span>
            </div>

            <!-- Inactive / Private State -->
            <div id="share-state-private" class="hidden flex-col items-center text-center p-5 rounded-xl border-2 border-dashed border-neutral-200 dark:border-neutral-800 bg-[#fafcfa] dark:bg-[#121712]/40 gap-3">
                <div class="w-11 h-11 rounded-full bg-[#ebf0eb] dark:bg-neutral-800 flex items-center justify-center text-[#63875e] shadow-2xs">
                    <!-- Padlock Icon for Private State -->
                    <svg class="w-5.5 h-5.5 text-[#63875e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </div>
                <div>
                    <h4 class="text-sm font-bold text-[var(--text-color)]">{t('share.privateTitle')}</h4>
                    <p class="text-xs text-[var(--lt-text-color)] mt-0.5">{t('share.privateDesc')}</p>
                </div>
                <Button id="share-generate-btn" variant="Form" class="w-full py-2.5 text-xs font-semibold mt-1">
                    {t('share.generateBtn')}
                </Button>
            </div>

            <!-- Active / Public State -->
            <div id="share-state-public" class="hidden flex-col gap-3">
                <div class="flex items-center justify-between bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 rounded-xl px-3 py-2">
                    <span class="text-xs font-bold text-emerald-700 dark:text-emerald-300 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        {t('share.publicActive')}
                    </span>
                    <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-medium">{t('share.readOnly')}</span>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-semibold text-[#6e826b] dark:text-neutral-400">{t('share.urlLabel')}</label>
                    <div class="flex items-center gap-2">
                        <input
                            type="text"
                            id="share-url-input"
                            readonly
                            class="flex-1 bg-[#EBF0EB] dark:bg-neutral-800 text-xs text-[#121712] dark:text-neutral-200 rounded-xl px-3 py-2.5 border border-transparent outline-none select-all font-mono"
                        />
                        <button
                            type="button"
                            id="share-copy-btn"
                            class="px-3.5 py-2.5 rounded-xl bg-[#63875e] hover:bg-[#52704e] text-white text-xs font-bold transition-all shrink-0 active:scale-95 shadow-xs cursor-pointer"
                        >
                            {t('share.copy')}
                        </button>
                    </div>
                </div>

                <div class="flex items-center justify-between pt-2 border-t border-neutral-200/60 dark:border-neutral-800">
                    <a
                        id="share-preview-link"
                        href="#"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-xs font-semibold text-[#63875e] hover:underline flex items-center gap-1"
                    >
                        <span>{t('share.openTab')}</span>
                        <span>↗</span>
                    </a>

                    <button
                        type="button"
                        id="share-revoke-btn"
                        class="text-xs text-red-600 dark:text-red-400 hover:underline font-semibold cursor-pointer"
                    >
                        {t('share.revoke')}
                    </button>
                </div>
            </div>

            <DialogFooter class="mt-2">
                <DialogClose asChild>
                    <button
                        type="button"
                        id="share-close-dialog-btn"
                        class="w-full text-center py-2.5 px-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-100 hover:bg-neutral-200 dark:bg-neutral-800 dark:hover:bg-neutral-700 text-xs font-bold text-[var(--text-color)] transition-all cursor-pointer active:scale-95"
                    >
                        {t('share.done')}
                    </button>
                </DialogClose>
            </DialogFooter>
        </div>
    </DialogContent>
</Dialog>

<script>
    import { showToast } from "@/utils/toast";

    function initTripShareModal() {
        const wrapper = document.getElementById("trip-share-wrapper");
        if (!wrapper || wrapper.dataset.bound === "true") return;
        wrapper.dataset.bound = "true";

        const isEs = window.location.pathname.startsWith("/es");

        const tripId = wrapper.dataset.tripId;
        if (!tripId) return;

        const loadingEl = document.getElementById("share-loading");
        const privateStateEl = document.getElementById("share-state-private");
        const publicStateEl = document.getElementById("share-state-public");
        const urlInput = document.getElementById("share-url-input") as HTMLInputElement | null;
        const previewLink = document.getElementById("share-preview-link") as HTMLAnchorElement | null;
        const generateBtn = document.getElementById("share-generate-btn") as HTMLButtonElement | null;
        const copyBtn = document.getElementById("share-copy-btn") as HTMLButtonElement | null;
        const revokeBtn = document.getElementById("share-revoke-btn") as HTMLButtonElement | null;

        async function fetchShareState() {
            try {
                loadingEl?.classList.remove("hidden");
                privateStateEl?.classList.add("hidden");
                publicStateEl?.classList.add("hidden");

                const res = await fetch(`/api/trips/${tripId}/share`);
                if (!res.ok) throw new Error("Failed to fetch sharing state");
                const data = await res.json();

                loadingEl?.classList.add("hidden");

                if (data.isPublic && data.shareUrl) {
                    if (urlInput) urlInput.value = data.shareUrl;
                    if (previewLink) previewLink.href = data.shareUrl;
                    publicStateEl?.classList.remove("hidden");
                    publicStateEl?.classList.add("flex");
                } else {
                    privateStateEl?.classList.remove("hidden");
                    privateStateEl?.classList.add("flex");
                }
            } catch (err) {
                console.error("Error checking share state:", err);
                loadingEl?.classList.add("hidden");
                privateStateEl?.classList.remove("hidden");
                privateStateEl?.classList.add("flex");
            }
        }

        generateBtn?.addEventListener("click", async () => {
            if (generateBtn) {
                generateBtn.disabled = true;
                generateBtn.textContent = isEs ? "Generando..." : "Generating...";
            }

            try {
                const res = await fetch(`/api/trips/${tripId}/share`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ action: "generate" }),
                });

                if (!res.ok) throw new Error("Could not generate share link");
                const data = await res.json();

                if (urlInput) urlInput.value = data.shareUrl;
                if (previewLink) previewLink.href = data.shareUrl;

                privateStateEl?.classList.add("hidden");
                privateStateEl?.classList.remove("flex");
                publicStateEl?.classList.remove("hidden");
                publicStateEl?.classList.add("flex");

                showToast(isEs 
                    ? "¡Enlace público generado! Cualquier persona con el enlace puede ver este viaje." 
                    : "Public link generated! Anyone with this link can view this trip.", 
                    "success"
                );
            } catch (err) {
                console.error("Error generating share link:", err);
                showToast(isEs ? "Error al generar el enlace público." : "Failed to generate public link.", "error");
            } finally {
                if (generateBtn) {
                    generateBtn.disabled = false;
                    generateBtn.textContent = isEs ? "Generar Enlace Público" : "Generate Public Link";
                }
            }
        });

        copyBtn?.addEventListener("click", async () => {
            if (!urlInput?.value) return;
            try {
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    await navigator.clipboard.writeText(urlInput.value);
                } else {
                    urlInput.select();
                    urlInput.setSelectionRange(0, 99999);
                }
                if (copyBtn) {
                    copyBtn.textContent = isEs ? "¡Copiado! ✓" : "Copied! ✓";
                    setTimeout(() => {
                        if (copyBtn) copyBtn.textContent = isEs ? "Copiar" : "Copy";
                    }, 2000);
                }
                showToast(isEs ? "¡Enlace copiado al portapapeles! 📋" : "Link copied to clipboard! 📋", "success");
            } catch {
                showToast(isEs ? "¡Enlace copiado al portapapeles!" : "Link copied to clipboard!", "success");
            }
        });

        revokeBtn?.addEventListener("click", async () => {
            const confirmMsg = isEs
                ? "¿Estás seguro de que deseas revocar este enlace público? Tus amigos y familiares ya no podrán ver este escaparate."
                : "Are you sure you want to revoke this public link? Friends and family will no longer be able to view this showcase.";
            if (!confirm(confirmMsg)) {
                return;
            }

            try {
                const res = await fetch(`/api/trips/${tripId}/share`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ action: "revoke" }),
                });

                if (!res.ok) throw new Error("Could not revoke share link");

                publicStateEl?.classList.add("hidden");
                publicStateEl?.classList.remove("flex");
                privateStateEl?.classList.remove("hidden");
                privateStateEl?.classList.add("flex");

                showToast(isEs ? "Enlace público revocado. El viaje ahora es privado." : "Public link revoked. The trip is now private.", "info");
            } catch (err) {
                console.error("Error revoking share link:", err);
                showToast(isEs ? "Error al revocar el enlace." : "Failed to revoke link.", "error");
            }
        });

        // Trigger fetch whenever share button is clicked
        document.querySelectorAll('[data-dialog-for="trip-share-dialog"]').forEach((trigger) => {
            trigger.addEventListener("click", () => {
                fetchShareState();
            });
        });
    }

    document.addEventListener("astro:page-load", initTripShareModal);
</script>
