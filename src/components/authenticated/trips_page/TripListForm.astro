            <Textarea class="rounded-[12px] mb-6 p-4 text-[16px] text-[#63875E] bg-[#EBF0EB]" size="lg" id="description" placeholder="Trip Description" />
            <p>Start Date / End Date</p>
            <div id="date-inputs" class="flex gap-4">
