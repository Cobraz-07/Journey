<script>
    import { db } from "@/firebase/config";
    import { collection, doc, setDoc, getDoc, updateDoc } from "firebase/firestore";

    const tripForm = document.querySelector("#trip-form") as HTMLFormElement;
    const formTitle = document.getElementById("title") as HTMLInputElement;
    const formDescription = document.getElementById("description") as HTMLTextAreaElement;
    const formStartDate = document.getElementById("start-date") as HTMLInputElement;
    const formEndDate = document.getElementById("end-date") as HTMLInputElement;
    const formCountry = document.getElementById("country") as HTMLInputElement;
    const email = tripForm.dataset.message;
    const userDocRef = doc(db, "users", email ?? "unknown_user");

    let countryCode = "";

    document.querySelector(".starwind-select")?.addEventListener("starwind-select:change", (event) => {
        const customEvent = event as CustomEvent;
        countryCode = customEvent.detail.value;
    });

    tripForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        // Get current tripCounter or initialize if not present
        const userSnap = await getDoc(userDocRef);
        let tripCounter = userSnap.data()?.tripCounter ?? 9999999999;

        const tripDocRef = doc(collection(userDocRef, "trips"), `trip nº${tripCounter}`);

        await setDoc(tripDocRef, {
            title: `${formTitle.value}`,
            description: `${formDescription.value}`,
            startDate: `${formStartDate.value}`,
            endDate: `${formEndDate.value}`,
            country: `${formCountry.textContent}`,
            countryCode: countryCode,
            createdAt: new Date().toISOString(),
        });

        await updateDoc(userDocRef, { tripCounter: tripCounter - 1 });

        window.location.href = "/authenticated/trips";
    });
</script>
