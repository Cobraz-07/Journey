                <DialogTitle>Create new trip</DialogTitle>
            </DialogHeader>
            <Input name="trip title" id="title" type="text" placeholder="Trip Title" class="rounded-[12px] mb-6 h-14 p-4 text-[16px] text-[#63875E] bg-[#EBF0EB]" />
            <p>Start Date / End Date</p>
            <div id="date-inputs" class="flex gap-4">
                <Input name="trip start date" id="start-date" type="date" class="rounded-[12px] mb-6 h-14 p-4 text-[16px] text-[#63875E] bg-[#EBF0EB]" />
                <Input name="trip end date" id="end-date" type="date" class="rounded-[12px] mb-6 h-14 p-4 text-[16px] text-[#63875E] bg-[#EBF0EB]" />
            </div>
            <Select name="country" class="w-full">
