---
import { Dialog, DialogContent, DialogFooter, DialogHeader, DialogTitle } from "@/components/starwind/dialog";
import { Select, SelectTrigger, SelectValue, SelectContent, SelectItem, SelectGroup } from "@/components/starwind/select";
import { Input } from "@/components/starwind/input";
import { Button } from "@/components/starwind/button";

import { projectAuth } from "@/firebase/config";
const { email = projectAuth.currentUser?.email } = Astro.props;
