---
import { Dialog, DialogContent, DialogFooter, DialogHeader, DialogTitle } from "@/components/starwind/dialog";
import { Input } from "@/components/starwind/input";
import { Button } from "@/components/starwind/button";
import { Textarea } from "@/components/starwind/textarea";
import { Icon } from "astro-icon/components";
import { countries } from "@/utils/countries";

const { uid } = Astro.props;
---

<Dialog id="trip-form-dialog">
    <DialogContent class="w-9/10 max-w-lg max-h-[90vh] overflow-y-auto rounded-2xl p-6">
        <form id="trip-form" data-uid={uid} method="dialog" class="flex flex-col gap-4 h-full">
            <DialogHeader class="mb-4">
                <DialogTitle class="text-xl font-bold text-[#121712] dark:text-white">Create New Trip</DialogTitle>
            </DialogHeader>
            <Input name="trip title" id="trip-title" type="text" placeholder="Trip title" maxlength={100} class="rounded-[12px] h-12 p-3 text-[15px] text-[#63875E] bg-[#EBF0EB]" required />
            <Textarea class="rounded-[12px] p-3 text-[15px] text-[#63875E] bg-[#EBF0EB]" size="lg" id="trip-description" maxlength={1000} placeholder="Trip description (max. 1000 characters)" />
            
            <!-- Optional Cover Photo -->
            <p class="text-xs font-semibold text-[#6e826b]">Cover Photo (Optional)</p>
            <div id="trip-cover-dropzone" class="border-2 border-dashed border-[#aadba3] hover:border-[#63875e] bg-white/60 dark:bg-neutral-900/40 rounded-xl p-4 text-center cursor-pointer transition-all flex flex-col items-center justify-center gap-1.5 relative">
                <input id="trip-cover-input" type="file" accept="image/*" class="hidden" />
                <div id="trip-cover-placeholder" class="flex items-center gap-2 text-[#63875e]">
                    <Icon name="image" class="w-5 h-5" />
                    <span class="text-xs font-medium">Add cover photo</span>
                </div>
                <div id="trip-cover-preview-wrapper" class="hidden relative w-full">
                    <img id="trip-cover-preview" src="" alt="Preview" class="max-h-32 mx-auto rounded-lg object-cover shadow" />
                    <button id="trip-cover-remove-btn" type="button" class="absolute top-0 right-0 bg-black/70 hover:bg-black text-white rounded-full w-5 h-5 flex items-center justify-center text-xs">✕</button>
                    <p id="trip-cover-savings" class="text-[11px] text-[#63875e] mt-1 font-medium"></p>
                </div>
            </div>

            <p class="text-xs font-semibold text-[#6e826b]">Start / End Date</p>
            <div id="date-inputs" class="flex gap-4">
                <Input name="trip start date" id="trip-start-date" type="date" class="rounded-[12px] h-12 p-3 text-[15px] text-[#63875E] bg-[#EBF0EB]" required />
                <Input name="trip end date" id="trip-end-date" type="date" class="rounded-[12px] h-12 p-3 text-[15px] text-[#63875E] bg-[#EBF0EB]" required />
            </div>

            <!-- Country Selector with Real-time Search -->
            <div class="relative flex flex-col gap-1 w-full" id="country-combobox">
                <p class="text-xs font-semibold text-[#6e826b]">Destination Country</p>
                
                <!-- Trigger button -->
                <button
                    type="button"
                    id="country-combobox-trigger"
                    class="w-full flex items-center justify-between rounded-[12px] h-12 p-3 text-[15px] text-[#63875E] bg-[#EBF0EB] border border-transparent focus:border-[#aadba3] transition-all cursor-pointer text-left select-none"
                    aria-expanded="false"
                >
                    <div class="flex items-center gap-2.5 truncate">
                        <img id="country-selected-flag" src="" class="w-5 h-3.5 rounded-xs object-cover shadow-xs hidden" alt="" />
                        <span id="country-selected-name" class="text-[#63875E] font-medium truncate">Select a country</span>
                    </div>
                    <svg class="w-4 h-4 text-[#63875E] shrink-0 transition-transform duration-200" id="country-combobox-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>

                <!-- Hidden inputs for validation & data -->
                <input type="hidden" id="trip-country-name" name="country" required />
                <input type="hidden" id="trip-country-code" name="countryCode" required />

                <!-- Dropdown menu -->
                <div
                    id="country-combobox-dropdown"
                    class="hidden absolute top-full left-0 right-0 z-50 mt-1 bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-xl shadow-2xl overflow-hidden flex flex-col max-h-64"
                >
                    <!-- Search Input Box -->
                    <div class="p-2 border-b border-neutral-100 dark:border-neutral-800 sticky top-0 bg-white dark:bg-neutral-900 z-10">
                        <div class="relative flex items-center">
                            <svg class="w-4 h-4 text-[#63875E] absolute left-3 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                            <input
                                type="text"
                                id="country-search-input"
                                placeholder="Type to search country..."
                                autocomplete="off"
                                class="w-full bg-[#EBF0EB] text-[#63875E] placeholder:text-[#63875E]/60 text-sm rounded-lg pl-9 pr-3 py-2 outline-none border border-transparent focus:border-[#63875e]/40 transition-colors"
                            />
                        </div>
                    </div>

                    <!-- Filtered List Items -->
                    <div id="country-options-list" class="overflow-y-auto flex-1 divide-y divide-neutral-50 dark:divide-neutral-800/40">
                        {countries.map((c) => (
                            <button
                                type="button"
                                data-country-code={c.code}
                                data-country-name={c.name}
                                class="country-option-item w-full flex items-center gap-2.5 px-3 py-2.5 text-left text-sm text-neutral-800 dark:text-neutral-200 hover:bg-[#EBF0EB] dark:hover:bg-neutral-800 transition-colors cursor-pointer"
                            >
                                <img src={`https://flagcdn.com/${c.code}.svg`} class="w-4.5 h-3 rounded-xs object-cover shadow-xs shrink-0" alt="" loading="lazy" />
                                <span class="truncate font-medium">{c.name}</span>
                            </button>
                        ))}
                    </div>

                    <!-- Empty state -->
                    <div id="country-empty-state" class="hidden p-4 text-center text-xs text-neutral-400">
                        No country found
                    </div>
                </div>
            </div>

            <DialogFooter class="mt-auto">
                <Button type="submit" variant="Form">Create Trip</Button>
            </DialogFooter>
        </form>
    </DialogContent>
</Dialog>

<script>
    import { db, projectAuth } from "@/firebase/config";
    import { collection, doc, setDoc, getDocs } from "firebase/firestore";
    import { compressImageToWebP, type CompressedImageResult } from "@/utils/imageCompressor";
    import { uploadTripCover, MAX_TRIPS_PER_USER } from "@/firebase/storageService";
    import { showToast } from "@/utils/toast";

    function initTripListForm() {
        const tripForm = document.querySelector("#trip-form") as HTMLFormElement;
        if (!tripForm || tripForm.dataset.bound === "true") return;
        tripForm.dataset.bound = "true";

        const formTitle = document.getElementById("trip-title") as HTMLInputElement;
        const formDescription = document.getElementById("trip-description") as HTMLTextAreaElement;
        const formStartDate = document.getElementById("trip-start-date") as HTMLInputElement;
        const formEndDate = document.getElementById("trip-end-date") as HTMLInputElement;
        const uid = tripForm.dataset.uid;
        if (!uid) return;

        const userDocRef = doc(db, "users", uid);

        // Country Combobox with Search
        const comboboxTrigger = document.getElementById("country-combobox-trigger") as HTMLButtonElement;
        const comboboxDropdown = document.getElementById("country-combobox-dropdown") as HTMLDivElement;
        const comboboxArrow = document.getElementById("country-combobox-arrow") as HTMLElement;
        const searchInput = document.getElementById("country-search-input") as HTMLInputElement;
        const selectedFlag = document.getElementById("country-selected-flag") as HTMLImageElement;
        const selectedName = document.getElementById("country-selected-name") as HTMLElement;
        const countryNameInput = document.getElementById("trip-country-name") as HTMLInputElement;
        const countryCodeInput = document.getElementById("trip-country-code") as HTMLInputElement;
        const optionsList = document.getElementById("country-options-list") as HTMLDivElement;
        const emptyState = document.getElementById("country-empty-state") as HTMLDivElement;
        const optionItems = optionsList?.querySelectorAll(".country-option-item") as NodeListOf<HTMLButtonElement>;

        let isComboboxOpen = false;

        function openCombobox() {
            isComboboxOpen = true;
            comboboxDropdown?.classList.remove("hidden");
            comboboxArrow?.classList.add("rotate-180");
            if (searchInput) searchInput.value = "";
            filterCountryOptions("");
            setTimeout(() => searchInput?.focus(), 60);
        }

        function closeCombobox() {
            isComboboxOpen = false;
            comboboxDropdown?.classList.add("hidden");
            comboboxArrow?.classList.remove("rotate-180");
        }

        function filterCountryOptions(query: string) {
            const normalized = query.toLowerCase().trim();
            let visibleCount = 0;

            optionItems?.forEach((item) => {
                const name = (item.dataset.countryName || "").toLowerCase();
                const code = (item.dataset.countryCode || "").toLowerCase();
                const matches = name.includes(normalized) || code.includes(normalized);

                item.classList.toggle("hidden", !matches);
                if (matches) visibleCount++;
            });

            emptyState?.classList.toggle("hidden", visibleCount > 0);
        }

        comboboxTrigger?.addEventListener("click", (e) => {
            e.stopPropagation();
            if (isComboboxOpen) closeCombobox();
            else openCombobox();
        });

        searchInput?.addEventListener("input", (e) => {
            filterCountryOptions((e.target as HTMLInputElement).value);
        });

        searchInput?.addEventListener("click", (e) => e.stopPropagation());

        optionsList?.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;
            const option = target.closest(".country-option-item") as HTMLButtonElement;
            if (option) {
                const code = option.dataset.countryCode || "";
                const name = option.dataset.countryName || "";

                if (countryCodeInput) countryCodeInput.value = code;
                if (countryNameInput) countryNameInput.value = name;

                if (selectedName) selectedName.textContent = name;
                if (selectedFlag) {
                    selectedFlag.src = `https://flagcdn.com/${code}.svg`;
                    selectedFlag.classList.remove("hidden");
                }

                closeCombobox();
            }
        });

        document.addEventListener("click", (e) => {
            if (!document.getElementById("country-combobox")?.contains(e.target as Node)) {
                closeCombobox();
            }
        });

        // Cover Photo Elements
        const coverDropzone = document.getElementById("trip-cover-dropzone") as HTMLDivElement;
        const coverInput = document.getElementById("trip-cover-input") as HTMLInputElement;
        const coverPlaceholder = document.getElementById("trip-cover-placeholder") as HTMLDivElement;
        const previewWrapper = document.getElementById("trip-cover-preview-wrapper") as HTMLDivElement;
        const previewImg = document.getElementById("trip-cover-preview") as HTMLImageElement;
        const savingsEl = document.getElementById("trip-cover-savings") as HTMLElement;
        const removeCoverBtn = document.getElementById("trip-cover-remove-btn") as HTMLButtonElement;

        let tripCoverCompressed: CompressedImageResult | null = null;

        coverInput?.addEventListener("click", (e) => e.stopPropagation());

        coverDropzone?.addEventListener("click", (e) => {
            if (e.target === removeCoverBtn) return;
            e.stopPropagation();
            coverInput?.click();
        });

        coverInput?.addEventListener("change", async () => {
            if (!coverInput.files?.[0]) return;
            try {
                tripCoverCompressed = await compressImageToWebP(coverInput.files[0], { maxWidth: 2000, maxHeight: 1200, quality: 0.88 });
                if (previewImg) previewImg.src = tripCoverCompressed.previewUrl;
                if (savingsEl) {
                    savingsEl.textContent = `Optimizado WebP: ${(tripCoverCompressed.compressedSize / 1024).toFixed(0)} KB (-${tripCoverCompressed.savingsPercentage}%)`;
                }
                coverPlaceholder?.classList.add("hidden");
                previewWrapper?.classList.remove("hidden");
            } catch (err: unknown) {
                const message = err instanceof Error ? err.message : "Failed to process the image.";
                showToast(message, "error");
            }
        });

        removeCoverBtn?.addEventListener("click", (e) => {
            e.stopPropagation();
            tripCoverCompressed = null;
            if (coverInput) coverInput.value = "";
            previewWrapper?.classList.add("hidden");
            coverPlaceholder?.classList.remove("hidden");
        });

        tripForm.addEventListener("submit", async (e) => {
            e.preventDefault();

            if (!countryCodeInput?.value || !countryNameInput?.value) {
                showToast("Please select a country.", "error");
                return;
            }

            const submitBtn = tripForm.querySelector("button[type=submit]") as HTMLButtonElement;
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = "Creating trip...";
            }

            try {
                await projectAuth.authStateReady();

                // Check max trips limit
                const existingTripsSnap = await getDocs(collection(userDocRef, "trips"));
                if (existingTripsSnap.size >= MAX_TRIPS_PER_USER) {
                    showToast(`You have reached the maximum limit of ${MAX_TRIPS_PER_USER} trips per account.`, "error");
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.textContent = "Create Trip";
                    }
                    return;
                }

                // Generate robust auto-ID for new trip document
                const newTripDocRef = doc(collection(userDocRef, "trips"));
                const tripId = newTripDocRef.id;

                let coverUrl = "";
                let coverStoragePath = "";

                if (tripCoverCompressed) {
                    if (submitBtn) submitBtn.textContent = "Uploading cover...";
                    const coverResult = await uploadTripCover(uid, tripId, tripCoverCompressed.file);
                    coverUrl = coverResult.url;
                    coverStoragePath = coverResult.storagePath;
                }

                await setDoc(newTripDocRef, {
                    title: formTitle?.value || "Untitled",
                    description: formDescription?.value || "",
                    startDate: formStartDate?.value || "",
                    endDate: formEndDate?.value || "",
                    country: countryNameInput.value,
                    countryCode: countryCodeInput.value,
                    coverUrl: coverUrl || null,
                    coverStoragePath: coverStoragePath || null,
                    createdAt: new Date().toISOString(),
                });

                window.location.href = "/authenticated/trips";
            } catch (err) {
                console.error("Error creating trip:", err);
                showToast("Failed to create the trip.", "error");
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.textContent = "Create Trip";
                }
            }
        });
    }

    document.addEventListener("astro:page-load", initTripListForm);
</script>
