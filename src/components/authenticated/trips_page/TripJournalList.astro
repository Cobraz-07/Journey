---
const { tripID, uid } = Astro.props;
---

<div class="flex flex-col gap-2 p-2" id="journal-list" data-trip-id={tripID} data-uid={uid}>
    <!-- Loading Shimmer Skeletons -->
    <div class="flex flex-col gap-3 p-2">
        {Array.from({ length: 2 }).map(() => (
            <div class="flex flex-col gap-2 p-4 rounded-xl border border-neutral-200/50 dark:border-neutral-800 bg-white/40 dark:bg-neutral-900/30">
                <div class="flex justify-between items-start">
                    <div class="space-y-1.5 w-1/2">
                        <div class="h-4.5 w-3/4 rounded-md skeleton-shimmer" />
                        <div class="h-3 w-1/3 rounded-md skeleton-shimmer" />
                    </div>
                </div>
                <div class="space-y-1.5 mt-2">
                    <div class="h-3.5 w-full rounded-md skeleton-shimmer" />
                    <div class="h-3.5 w-4/5 rounded-md skeleton-shimmer" />
                </div>
            </div>
        ))}
    </div>
</div>

<script>
    import { db, projectAuth } from "@/firebase/config";
    import { collection, getDocs, doc, query, orderBy } from "firebase/firestore";
    import { deleteJournalEntry } from "@/firebase/storageService";
    import { escapeHtml } from "@/utils/escapeHtml";
    import { formatDate } from "@/utils/formatDate";

    function initJournalList() {
        const journalList = document.getElementById("journal-list") as HTMLDivElement;
        if (!journalList || journalList.dataset.bound === "true") return;
        journalList.dataset.bound = "true";

        const isEs = window.location.pathname.startsWith("/es");
        const uid = journalList.dataset.uid;
        const tripId = journalList.dataset.tripId;
        if (!uid || !tripId) return;

        const userDocRef = doc(db, "users", uid);
        const tripDocRef = doc(collection(userDocRef, "trips"), `${tripId}`);
        const journalCollectionRef = collection(tripDocRef, "journal");

        // Add event listener to journal list for deletion
        journalList.addEventListener("click", async (event) => {
            const target = event.target as HTMLElement;
            const deleteButton = target.closest("[data-delete-journal]") as HTMLButtonElement;

            if (deleteButton) {
                const journalId = deleteButton.dataset.deleteJournal;
                const storagePath = deleteButton.dataset.deleteStoragePath;
                const imageUrl = deleteButton.dataset.deleteImageUrl;
                const confirmMsg = isEs ? "¿Deseas eliminar esta entrada del diario?" : "Do you want to delete this journal entry?";
                if (journalId && confirm(confirmMsg)) {
                    try {
                        await deleteJournalEntry(uid, tripId, journalId, storagePath, imageUrl);
                        renderJournals();
                    } catch (error) {
                        console.error("Error deleting journal:", error);
                    }
                }
            }
        });

        async function renderJournals() {
            try {
                await projectAuth.authStateReady();
                const q = query(journalCollectionRef, orderBy("date", "desc"));
                const journalsSnapshot = await getDocs(q);
                if (journalsSnapshot.empty) {
                    journalList.innerHTML = `
                        <div class="flex flex-col items-center justify-center w-full h-44 text-center gap-2 p-6 rounded-2xl border-2 border-dashed border-neutral-200 dark:border-neutral-800 bg-[#fafcfa] dark:bg-[#121712]/30">
                            <h3 class="text-sm font-bold text-[var(--text-color)]">${isEs ? "Aún no hay entradas en el diario" : "No journal entries yet"}</h3>
                            <p class="text-xs text-[var(--lt-text-color)]">${isEs ? "Escribe tu primera anécdota o recuerdo de viaje." : "Write your first anecdote or travel memory."}</p>
                        </div>
                    `;
                    return;
                }

                const journalsArray = journalsSnapshot.docs.map((doc) => ({
                    id: doc.id,
                    data: doc.data(),
                }));

                let html = "";
                journalsArray.forEach((journal) => {
                    const journalData = journal.data;
                    const hasImage = Boolean(journalData?.imageUrl);

                    const safeTitle = escapeHtml(journalData?.title) || (isEs ? "Entrada sin título" : "Untitled Journal");
                    const safeDescription = escapeHtml(journalData?.description);
                    const safeImageUrl = escapeHtml(journalData?.imageUrl);
                    const safeStoragePath = escapeHtml(journalData?.imageStoragePath);

                    html += `
                        <div class="w-full flex flex-col gap-3 p-4 rounded-xl hover:bg-neutral-50 dark:hover:bg-neutral-900/30 transition-colors">
                            <div class="flex justify-between items-start w-full">
                                <div>
                                    <h4 class="font-bold text-base text-[var(--text-color)]">${safeTitle}</h4>
                                    <p class="text-xs text-[var(--lt-text-color)] font-medium mt-0.5">${formatDate(journalData?.date)}</p>
                                </div>
                                <button data-delete-journal="${escapeHtml(journal.id)}" data-delete-storage-path="${safeStoragePath}" data-delete-image-url="${safeImageUrl}" class="p-1.5 text-neutral-400 hover:text-red-600 rounded-lg hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors cursor-pointer active:scale-95" title="${isEs ? "Eliminar diario" : "Delete Journal"}">
                                    <img src="/delete.svg" class="w-4.5 h-4.5" />
                                </button>
                            </div>
                            
                            ${safeDescription ? `<p class="text-sm text-[var(--lt-text-color)] whitespace-pre-line leading-relaxed">${safeDescription}</p>` : ""}

                            ${hasImage ? `
                                <div class="mt-1 max-w-sm rounded-xl overflow-hidden border border-neutral-200 dark:border-neutral-800 shadow-xs cursor-pointer group" data-journal-img-url="${safeImageUrl}" data-journal-img-title="${safeTitle}">
                                    <img src="${safeImageUrl}" alt="${safeTitle}" class="w-full max-h-56 object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
                                </div>
                            ` : ""}
                        </div>
                        <div class="w-9/10 bg-neutral-200/80 dark:bg-neutral-800 h-0.5 m-auto"></div>
                    `;
                });
                journalList.innerHTML = html;

                // Attach click handlers to journal images for lightbox
                journalList.querySelectorAll("[data-journal-img-url]").forEach((imgContainer) => {
                    imgContainer.addEventListener("click", () => {
                        const url = (imgContainer as HTMLElement).dataset.journalImgUrl;
                        const title = (imgContainer as HTMLElement).dataset.journalImgTitle;
                        if (!url) return;
                        
                        window.dispatchEvent(
                            new CustomEvent("open-trip-lightbox", {
                                detail: {
                                    photos: [{ id: "journal_img", url, storagePath: "", caption: title, createdAt: "" }],
                                    startIndex: 0,
                                    uid,
                                    tripId,
                                },
                            })
                        );
                    });
                });
            } catch (err) {
                console.error("Error rendering journals:", err);
                journalList.innerHTML = `
                    <div class="flex flex-col items-center justify-center w-full h-40">
                        <p class="text-center text-red-500 font-medium">${isEs ? "Error al cargar las entradas del diario." : "Failed to load journal entries."}</p>
                    </div>
                `;
            }
        }

        renderJournals();
    }

    document.addEventListener("astro:page-load", initJournalList);
</script>
