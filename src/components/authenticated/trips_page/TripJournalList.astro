---
const { email, tripID } = Astro.props;
import { Skeleton } from "@/components/starwind/skeleton";
---

<section data-email={email} data-trip-id={tripID} id="journal-list" class="flex flex-col items-left mx-6 my-4 gap-4">
    <!-- Journal items will be dynamically inserted here -->
    <Skeleton class="h-[66px] w-full" />
    <Skeleton class="h-[66px] w-full" />
    <Skeleton class="h-[66px] w-full" />
    <Skeleton class="h-[66px] w-full" />
    <Skeleton class="h-[66px] w-full" />
</section>

<script>
    import { db } from "@/firebase/config";
    import { collection, getDocs, doc, deleteDoc } from "firebase/firestore";

    const journalList = document.getElementById("journal-list") as HTMLDivElement;
    const email = journalList.dataset.email;
    const tripID = journalList.dataset.tripId;
    const userDocRef = doc(db, "users", email ?? "unknown_user");
    const tripDocRef = doc(userDocRef, "trips", tripID ?? "unknown_trip");
    const journalCollectionRef = collection(tripDocRef, "journal");

    // Event delegation for delete buttons
    journalList.addEventListener("click", async (event) => {
        const target = event.target as HTMLElement;
        const deleteButton = target.closest("[data-delete-journal]") as HTMLButtonElement;

        if (deleteButton) {
            const journalId = deleteButton.dataset.deleteJournal;
            if (journalId) {
                try {
                    await deleteDoc(doc(journalCollectionRef, journalId));
                    // Re-render journals instead of full page reload
                    renderJournals();
                } catch (error) {
                    console.error("Error deleting journal:", error);
                }
            }
        }
    });

    async function renderJournals() {
        const journalsSnapshot = await getDocs(journalCollectionRef);
        if (journalsSnapshot.empty) {
            journalList.innerHTML = `
                <div class="flex flex-col items-center justify-center w-full h-60">
                    <h3 class="text-xl font-semibold text-center text-[var(--lt-text-color)]">No journals added yet</h3>
                    <p class="text-center text-[var(--lt-text-color)]">Start by adding a new journal entry for this trip!</p>
                </div>
            `;
            return;
        }

        // Convert to array and sort by date (newest first)
        const journalsArray = journalsSnapshot.docs.map((doc) => ({
            id: doc.id,
            data: doc.data(),
        }));

        journalsArray.sort((a, b) => {
            const dateA = a.data?.date || "";
            const dateB = b.data?.date || "";
            // Sort in descending order (newest first)
            return dateB.localeCompare(dateA);
        });

        let html = "";
        journalsArray.forEach((journal) => {
            const journalData = journal.data;

            // Format date from yyyy-mm-dd to dd-mm-yyyy
            const formatDate = (dateString: string | undefined) => {
                if (!dateString) return "";
                const parts = dateString.split("-");
                if (parts.length === 3) {
                    return `${parts[2]}-${parts[1]}-${parts[0]}`;
                }
                return dateString; // Return original if format is unexpected
            };

            html += `
                <div class="w-full flex flex-col gap-2 p-4">
                    <div class="flex justify-between w-full">
                        <h4 class="font-bold text-[var(--text-color)]">${journalData?.title ?? "Untitled Journal"}</h4>
                        <p class="text-sm text-[var(--lt-text-color)]">${formatDate(journalData?.date)}</p>
                    </div>
                    <p class="text-[var(--lt-text-color)]">${journalData?.description ?? ""}</p>
                    <div class="flex justify-between items-center ml-auto">
                        <button data-delete-journal="${journal.id}" class="flex items-center gap-2 text-red-500 hover:text-red-700 transition-colors" title="Delete Journal">
                            <img src="/delete.svg" class="w-5 h-5" />
                        </button>
                    </div>
                </div>
                <div class="w-9/10 bg-neutral-200 h-0.5 m-auto"></div>
            `;
        });
        journalList.innerHTML = html;
    }

    renderJournals();
</script>
