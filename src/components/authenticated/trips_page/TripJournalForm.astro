---
import { Dialog, DialogContent, DialogFooter, DialogHeader, DialogTitle } from "@/components/starwind/dialog";
import { Input } from "@/components/starwind/input";
import { Button } from "@/components/starwind/button";
import { Textarea } from "@/components/starwind/textarea";
import { Icon } from "astro-icon/components";

const { uid, tripID } = Astro.props;
---

<Dialog id="journal-form-dialog" data-trip-id={tripID}>
    <DialogContent class="w-9/10 max-w-lg max-h-[90vh] overflow-y-auto rounded-2xl p-6">
        <form id="journal-form" data-uid={uid} method="dialog" class="flex flex-col gap-4 h-full">
            <DialogHeader class="mb-2">
                <DialogTitle class="text-xl font-bold text-[#121712] dark:text-white">Nuevo Registro en el Diario</DialogTitle>
            </DialogHeader>
            <Input name="journal title" id="journal-title" type="text" placeholder="Título del diario" maxlength={150} class="rounded-[12px] h-12 p-3 text-[15px] text-[#63875E] bg-[#EBF0EB]" required />
            <Textarea class="rounded-[12px] p-3 text-[15px] text-[#63875E] bg-[#EBF0EB]" size="lg" id="journal-description" maxlength={5000} placeholder="¿Qué aventuras viviste hoy? (máx. 5000 caracteres)" />
            
            <p class="text-xs font-semibold text-[#6e826b]">Fecha del diario</p>
            <Input name="journal date" id="journal-date" type="date" class="rounded-[12px] h-12 p-3 text-[15px] text-[#63875E] bg-[#EBF0EB]" required />

            <!-- Optional Image Attachment -->
            <p class="text-xs font-semibold text-[#6e826b]">Foto adjunta (Opcional)</p>
            <div id="journal-image-dropzone" class="border-2 border-dashed border-[#aadba3] hover:border-[#63875e] bg-white/60 dark:bg-neutral-900/40 rounded-xl p-4 text-center cursor-pointer transition-all flex flex-col items-center justify-center gap-1.5 relative">
                <input id="journal-image-input" type="file" accept="image/*" class="hidden" />
                <div id="journal-image-placeholder" class="flex items-center gap-2 text-[#63875e]">
                    <Icon name="image" class="w-5 h-5" />
                    <span class="text-xs font-medium">Añadir una foto a este día</span>
                </div>
                <div id="journal-image-preview-wrapper" class="hidden relative w-full">
                    <img id="journal-image-preview" src="" alt="Preview" class="max-h-36 mx-auto rounded-lg object-contain shadow" />
                    <button id="journal-image-remove-btn" type="button" class="absolute top-0 right-0 bg-black/70 hover:bg-black text-white rounded-full w-5 h-5 flex items-center justify-center text-xs">✕</button>
                    <p id="journal-image-savings" class="text-[11px] text-[#63875e] mt-1 font-medium"></p>
                </div>
            </div>

            <!-- Upload progress bar -->
            <div id="journal-upload-progress" class="hidden flex-col gap-1">
                <div class="flex justify-between text-xs text-[#6e826b] font-medium">
                    <span id="journal-progress-label">Guardando y subiendo foto...</span>
                </div>
                <div class="w-full bg-[#ebf0eb] h-1.5 rounded-full overflow-hidden">
                    <div class="bg-[#63875e] h-full w-full animate-pulse rounded-full"></div>
                </div>
            </div>

            <DialogFooter class="mt-4">
                <Button id="journal-submit-btn" type="submit" variant="Form" class="rounded-xl w-full">Guardar Diario</Button>
            </DialogFooter>
        </form>
    </DialogContent>
</Dialog>

<script>
    import { db, projectAuth } from "@/firebase/config";
    import { collection, doc, setDoc, getDocs } from "firebase/firestore";
    import { compressImageToWebP, type CompressedImageResult } from "@/utils/imageCompressor";
    import { uploadJournalImage, MAX_JOURNALS_PER_TRIP } from "@/firebase/storageService";
    import { showToast } from "@/utils/toast";

    function initTripJournalForm() {
        const journalFormDialog = document.getElementById("journal-form-dialog") as HTMLDivElement;
        const journalForm = document.querySelector("#journal-form") as HTMLFormElement;
        if (!journalForm || !journalFormDialog || journalForm.dataset.bound === "true") return;
        journalForm.dataset.bound = "true";

        const formTitle = document.getElementById("journal-title") as HTMLInputElement;
        const formDescription = document.getElementById("journal-description") as HTMLTextAreaElement;
        const formDate = document.getElementById("journal-date") as HTMLInputElement;
        const uid = journalForm.dataset.uid;
        const tripID = journalFormDialog.dataset.tripId;
        if (!uid || !tripID) return;

        const userDocRef = doc(db, "users", uid);

        // Journal Image handling
        const imageDropzone = document.getElementById("journal-image-dropzone") as HTMLDivElement;
        const imageInput = document.getElementById("journal-image-input") as HTMLInputElement;
        const imagePlaceholder = document.getElementById("journal-image-placeholder") as HTMLDivElement;
        const previewWrapper = document.getElementById("journal-image-preview-wrapper") as HTMLDivElement;
        const previewImg = document.getElementById("journal-image-preview") as HTMLImageElement;
        const savingsEl = document.getElementById("journal-image-savings") as HTMLElement;
        const removeImageBtn = document.getElementById("journal-image-remove-btn") as HTMLButtonElement;
        const submitBtn = document.getElementById("journal-submit-btn") as HTMLButtonElement;
        const progressWrapper = document.getElementById("journal-upload-progress") as HTMLDivElement;

        let journalCompressedResult: CompressedImageResult | null = null;

        imageInput?.addEventListener("click", (e) => e.stopPropagation());

        imageDropzone?.addEventListener("click", (e) => {
            if (e.target === removeImageBtn) return;
            e.stopPropagation();
            imageInput?.click();
        });

        imageInput?.addEventListener("change", async () => {
            if (!imageInput.files?.[0]) return;
            try {
                journalCompressedResult = await compressImageToWebP(imageInput.files[0]);
                if (previewImg) previewImg.src = journalCompressedResult.previewUrl;
                if (savingsEl) {
                    savingsEl.textContent = `Optimizado WebP: ${(journalCompressedResult.compressedSize / 1024).toFixed(0)} KB (-${journalCompressedResult.savingsPercentage}%)`;
                }
                imagePlaceholder?.classList.add("hidden");
                previewWrapper?.classList.remove("hidden");
            } catch (err: unknown) {
                const message = err instanceof Error ? err.message : "Error al procesar la imagen.";
                showToast(message, "error");
            }
        });

        removeImageBtn?.addEventListener("click", (e) => {
            e.stopPropagation();
            journalCompressedResult = null;
            if (imageInput) imageInput.value = "";
            previewWrapper?.classList.add("hidden");
            imagePlaceholder?.classList.remove("hidden");
        });

        journalForm.addEventListener("submit", async (e) => {
            e.preventDefault();

            if (submitBtn) submitBtn.disabled = true;
            progressWrapper?.classList.remove("hidden");

            try {
                await projectAuth.authStateReady();
                const tripDocRef = doc(collection(userDocRef, "trips"), `${tripID}`);
                const journalCollectionRef = collection(tripDocRef, "journal");

                // Check max journals limit
                const existingJournalsSnap = await getDocs(journalCollectionRef);
                if (existingJournalsSnap.size >= MAX_JOURNALS_PER_TRIP) {
                    showToast(`Has alcanzado el límite máximo de ${MAX_JOURNALS_PER_TRIP} entradas de diario para este viaje.`, "error");
                    if (submitBtn) submitBtn.disabled = false;
                    progressWrapper?.classList.add("hidden");
                    return;
                }

                const newJournalDocRef = doc(journalCollectionRef);
                const journalId = newJournalDocRef.id;

                let imageUrl = "";
                let imageStoragePath = "";
                if (journalCompressedResult) {
                    const result = await uploadJournalImage(uid, tripID, journalId, journalCompressedResult.file);
                    imageUrl = result.url;
                    imageStoragePath = result.storagePath;
                }

                await setDoc(newJournalDocRef, {
                    title: formTitle?.value || "Sin título",
                    description: formDescription?.value || "",
                    date: formDate?.value || "",
                    imageUrl: imageUrl || null,
                    imageStoragePath: imageStoragePath || null,
                    createdAt: new Date().toISOString(),
                });

                // Reset and close dialog
                journalCompressedResult = null;
                if (imageInput) imageInput.value = "";
                if (formTitle) formTitle.value = "";
                if (formDescription) formDescription.value = "";
                previewWrapper?.classList.add("hidden");
                imagePlaceholder?.classList.remove("hidden");
                progressWrapper?.classList.add("hidden");
                if (submitBtn) submitBtn.disabled = false;

                const closeBtn = document.querySelector("#journal-form-dialog .starwind-dialog-close, #journal-form-dialog [data-dialog-close]") as HTMLButtonElement;
                if (closeBtn) {
                    closeBtn.click();
                } else {
                    const d = document.querySelector("#journal-form-dialog dialog") as HTMLDialogElement;
                    d?.close();
                }

                showToast("Entrada de diario guardada con éxito.", "success");
                window.location.reload();
            } catch (err) {
                console.error("Error creating journal:", err);
                showToast("No se pudo crear la entrada del diario.", "error");
                if (submitBtn) submitBtn.disabled = false;
                progressWrapper?.classList.add("hidden");
            }
        });
    }

    document.addEventListener("astro:page-load", initTripJournalForm);
</script>
