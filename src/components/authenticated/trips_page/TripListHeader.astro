---
import { DialogTrigger } from "@/components/starwind/dialog";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="flex justify-between items-center items-left mx-6">
    <h2 class="mt-5 mb-3 text-[22px] font-extrabold">{t('trips.recentTrips')}</h2>
    <DialogTrigger for="trip-form-dialog" class="mt-2" asChild>
        <Icon name="add" class="w-7.5 h-7.5" />
    </DialogTrigger>
</section>
