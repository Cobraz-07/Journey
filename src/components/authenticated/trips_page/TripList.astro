<section class="flex flex-col items-left mx-6 my-4 gap-4">
    <div id="Summer in Paris" class="w-full flex items-center gap-4">
        <img src="https://flagcdn.com/fr.svg" width="40" class="h-7.5 trip-img" alt="France" />
        <div id="text-div">
            <h4 class="font-bold">Summer in Paris</h4>
            <h6 class="text-[var(--lt-text-color)]">Paris, France</h6>
        </div>
    </div>
    <p id="separator" class="w-9/10 bg-neutral-200 h-0.5 m-auto"></p>
    <div id="Exploring Tokyo" class="w-full flex items-center gap-4">
        <img src="https://flagcdn.com/jp.svg" width="40" class="h-7.5 trip-img" alt="Japan" />
        <div id="text-div">
            <h4 class="font-bold">Exploring Tokyo</h4>
            <h6 class="text-[var(--lt-text-color)]">Tokyo, Japan</h6>
        </div>
    </div>
</section>
