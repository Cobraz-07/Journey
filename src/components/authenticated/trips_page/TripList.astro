---
const { uid } = Astro.props;
import { Skeleton } from "@/components/starwind/skeleton";
---

<section data-uid={uid} id="trip-list" class="flex flex-col items-left mx-6 my-4 gap-4">
    <!-- Trip items will be dynamically inserted here -->
    <Skeleton class="h-[66px] w-full" />
    <Skeleton class="h-[66px] w-full" />
    <Skeleton class="h-[66px] w-full" />
    <Skeleton class="h-[66px] w-full" />
    <Skeleton class="h-[66px] w-full" />
</section>

<script>
    import { db, projectAuth } from "@/firebase/config";
    import { collection, getDocs, doc } from "firebase/firestore";
    import { escapeHtml } from "@/utils/escapeHtml";
    import { formatDate } from "@/utils/formatDate";

    const tripList = document.getElementById("trip-list") as HTMLDivElement;
    const uid = tripList.dataset.uid;
    const userDocRef = doc(db, "users", uid ?? "unknown_user");
    const tripsCollectionRef = collection(userDocRef, "trips");

    async function renderTrips() {
        try {
            await projectAuth.authStateReady();
            const tripsSnapshot = await getDocs(tripsCollectionRef);
            if (tripsSnapshot.empty) {
                tripList.innerHTML = `
                    <div class="flex flex-col items-center justify-center w-full h-60">
                        <h3 class="text-xl font-semibold text-center text-[var(--lt-text-color)]">No trips added yet</h3>
                        <p class="text-center text-[var(--lt-text-color)]">Start by adding a new trip to plan your next adventure!</p>
                    </div>
                `;
                return;
            }

            let html = "";
            tripsSnapshot.forEach((tripDoc) => {
                const tripData = tripDoc.data();
                const tripID = tripDoc.id;

                const safeCountryCode = escapeHtml(tripData?.countryCode);
                const safeCoverUrl = escapeHtml(tripData?.coverUrl);

                const coverHtml = tripData?.coverUrl 
                    ? `<div class="relative w-14 h-14 rounded-xl overflow-hidden shadow-sm shrink-0 border border-neutral-200 dark:border-neutral-700 bg-neutral-100">
                        <img src="${safeCoverUrl}" class="w-full h-full object-cover" alt="Cover" loading="lazy" />
                        ${safeCountryCode ? `<img src="https://flagcdn.com/${safeCountryCode}.svg" class="absolute bottom-1 right-1 w-4 h-3 rounded-xs shadow object-cover" alt="${safeCountryCode}" />` : ""}
                       </div>`
                    : `<div class="w-14 h-14 rounded-xl bg-[#ebf0eb] dark:bg-neutral-800 flex items-center justify-center shrink-0 border border-neutral-200 dark:border-neutral-700 shadow-sm">
                        <img src="https://flagcdn.com/${safeCountryCode}.svg" width="34" class="h-6 rounded-xs object-cover shadow-xs" alt="${safeCountryCode}" />
                       </div>`;

                html += `
                    <a href="/authenticated/trips/${encodeURIComponent(tripID ?? "Unnamed_Trip")}" class="hover:bg-neutral-50 dark:hover:bg-neutral-900/40 p-2 rounded-2xl transition-all">
                        <div class="w-full flex items-center gap-3.5">
                            ${coverHtml}
                            <div class="flex-1 min-w-0">
                                <h4 class="font-bold text-base text-[var(--text-color)] truncate">${escapeHtml(tripData?.title) || "Unnamed Trip"}</h4>
                                <h6 class="text-xs font-semibold text-[#63875e] truncate">${escapeHtml(tripData?.country) || "Nowhere"}</h6>
                                <h6 class="text-xs text-[var(--lt-text-color)] font-medium mt-0.5">${formatDate(tripData?.startDate)} / ${formatDate(tripData?.endDate)}</h6>
                            </div>
                        </div>
                    </a>
                    <p class="w-9/10 bg-neutral-200/70 dark:bg-neutral-800 h-0.5 m-auto"></p>
                `;
            });
            tripList.innerHTML = html;
        } catch (err) {
            console.error("Error fetching trips:", err);
            tripList.innerHTML = `
                <div class="flex flex-col items-center justify-center w-full h-40">
                    <p class="text-center text-red-500 font-medium">Error al cargar los viajes. Inténtalo de nuevo.</p>
                </div>
            `;
        }
    }

    renderTrips();
</script>
