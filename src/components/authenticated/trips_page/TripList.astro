---
const { uid } = Astro.props;
---

<section data-uid={uid} id="trip-list" class="flex flex-col items-left mx-6 my-4 gap-3">
    <!-- Rich Shimmer Skeleton Loaders -->
    <div class="flex flex-col gap-3" id="trip-list-skeletons">
        {Array.from({ length: 4 }).map(() => (
            <div class="flex items-center gap-3.5 p-2.5 rounded-2xl border border-neutral-200/50 dark:border-neutral-800 bg-white/40 dark:bg-neutral-900/30">
                <div class="w-14 h-14 rounded-xl skeleton-shimmer shrink-0" />
                <div class="flex-1 space-y-2">
                    <div class="h-4.5 w-2/3 rounded-md skeleton-shimmer" />
                    <div class="h-3.5 w-1/3 rounded-md skeleton-shimmer" />
                    <div class="h-3 w-1/2 rounded-md skeleton-shimmer" />
                </div>
            </div>
        ))}
    </div>
</section>

<script>
    import { db, projectAuth } from "@/firebase/config";
    import { collection, getDocs, doc } from "firebase/firestore";
    import { escapeHtml } from "@/utils/escapeHtml";
    import { formatDate } from "@/utils/formatDate";

    function initTripsList() {
        const tripList = document.getElementById("trip-list") as HTMLDivElement;
        if (!tripList) return;

        const uid = tripList.dataset.uid;
        if (!uid) return;

        const userDocRef = doc(db, "users", uid);
        const tripsCollectionRef = collection(userDocRef, "trips");

        async function renderTrips() {
            try {
                await projectAuth.authStateReady();
                const tripsSnapshot = await getDocs(tripsCollectionRef);
                if (tripsSnapshot.empty) {
                    tripList.innerHTML = `
                        <div class="flex flex-col items-center justify-center w-full h-60 text-center gap-2">
                            <div class="w-12 h-12 rounded-full bg-[#ebf0eb] dark:bg-neutral-800 flex items-center justify-center text-[#63875e] mb-1">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <h3 class="text-base font-bold text-[var(--text-color)]">Aún no tienes viajes registrados</h3>
                            <p class="text-xs text-[var(--lt-text-color)] max-w-xs">Crea tu primer viaje para comenzar a registrar diarios y fotos.</p>
                        </div>
                    `;
                    return;
                }

                let html = "";
                tripsSnapshot.forEach((tripDoc) => {
                    const tripData = tripDoc.data();
                    const tripID = tripDoc.id;

                    const safeCountryCode = escapeHtml(tripData?.countryCode);
                    const safeCoverUrl = escapeHtml(tripData?.coverUrl);

                    const coverHtml = tripData?.coverUrl 
                        ? `<div class="relative w-14 h-14 rounded-xl overflow-hidden shadow-xs shrink-0 border border-neutral-200/80 dark:border-neutral-700 bg-neutral-100">
                            <img src="${safeCoverUrl}" class="w-full h-full object-cover" alt="Cover" loading="lazy" />
                            ${safeCountryCode ? `<img src="https://flagcdn.com/${safeCountryCode}.svg" class="absolute bottom-1 right-1 w-4 h-3 rounded-xs shadow-xs object-cover" alt="${safeCountryCode}" />` : ""}
                           </div>`
                        : `<div class="w-14 h-14 rounded-xl bg-[#ebf0eb] dark:bg-neutral-800 flex items-center justify-center shrink-0 border border-neutral-200/80 dark:border-neutral-700 shadow-xs">
                            <img src="https://flagcdn.com/${safeCountryCode}.svg" width="34" class="h-6 rounded-xs object-cover shadow-xs" alt="${safeCountryCode}" />
                           </div>`;

                    html += `
                        <a href="/authenticated/trips/${encodeURIComponent(tripID ?? "Unnamed_Trip")}" class="hover:bg-white/80 dark:hover:bg-neutral-900/60 p-2.5 rounded-2xl transition-all duration-200 border border-transparent hover:border-neutral-200/60 dark:hover:border-neutral-800 shadow-xs hover:shadow-sm hover:-translate-y-0.5 active:scale-[0.99] group">
                            <div class="w-full flex items-center gap-3.5">
                                ${coverHtml}
                                <div class="flex-1 min-w-0">
                                    <h4 class="font-bold text-base text-[var(--text-color)] group-hover:text-[#63875e] transition-colors truncate">${escapeHtml(tripData?.title) || "Unnamed Trip"}</h4>
                                    <h6 class="text-xs font-semibold text-[#63875e] truncate">${escapeHtml(tripData?.country) || "Nowhere"}</h6>
                                    <h6 class="text-xs text-[var(--lt-text-color)] font-medium mt-0.5">${formatDate(tripData?.startDate)} / ${formatDate(tripData?.endDate)}</h6>
                                </div>
                                <svg class="w-4 h-4 text-neutral-400 group-hover:text-[#63875e] group-hover:translate-x-0.5 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </div>
                        </a>
                    `;
                });
                tripList.innerHTML = html;
            } catch (err) {
                console.error("Error fetching trips:", err);
                tripList.innerHTML = `
                    <div class="flex flex-col items-center justify-center w-full h-40">
                        <p class="text-center text-red-500 font-medium">Error al cargar los viajes. Inténtalo de nuevo.</p>
                    </div>
                `;
            }
        }

        renderTrips();
    }

    initTripsList();
    document.addEventListener("astro:page-load", initTripsList);
</script>
