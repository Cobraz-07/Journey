---
import Button from "@/components/starwind/button";
---

<section class="flex justify-center absolute w-full bottom-24">
    <Button variant="outline" class="rounded-full" id="logout-button">Log Out</Button>
</section>

<script>
    import { projectAuth } from "@/firebase/config";

    function initSignOutButton() {
        const logoutButton = document.querySelector("#logout-button") as HTMLButtonElement;
        if (!logoutButton || logoutButton.dataset.bound === "true") return;
        logoutButton.dataset.bound = "true";

        logoutButton.addEventListener("click", async (e) => {
            e.preventDefault();
            // Clear client-side Firebase Auth state
            await projectAuth.signOut();
            // Clear server-side session cookie
            await fetch("/api/session", { method: "DELETE" });
            window.location.href = "/";
        });
    }

    document.addEventListener("astro:page-load", initSignOutButton);
</script>
