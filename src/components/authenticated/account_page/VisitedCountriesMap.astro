---
import { worldMapCountries, WORLD_MAP_VIEWBOX } from "@/utils/worldMapData";

interface Props {
    uid?: string | null;
}

const { uid } = Astro.props;
---

<section class="w-full mx-auto px-3 sm:px-4" id="visited-map-section" data-uid={uid}>
    <!-- Main Card Container -->
    <div class="bg-white/70 dark:bg-neutral-900/60 backdrop-blur-md rounded-2xl sm:rounded-3xl p-3 sm:p-5 border border-neutral-200/70 dark:border-neutral-800 shadow-xs">
        
        <!-- 5-Metric Traveler Stats Grid -->
        <div class="grid grid-cols-3 sm:grid-cols-5 gap-1.5 sm:gap-2.5 mb-3">
            <!-- 1. World Explored % -->
            <div class="bg-[#ebf0eb] dark:bg-neutral-800/80 rounded-xl sm:rounded-2xl py-2 px-1.5 sm:p-2.5 text-center border border-[#e2eae0] dark:border-neutral-700/60 flex flex-col justify-center">
                <span class="text-[9px] sm:text-[10px] text-[#6e826b] dark:text-neutral-400 font-bold uppercase tracking-wider truncate">World</span>
                <span id="stat-world-percent" class="text-sm sm:text-base font-extrabold text-[#63875e] dark:text-[#8ac282] mt-0.5">—%</span>
            </div>

            <!-- 2. Continents Visited -->
            <div class="bg-[#ebf0eb] dark:bg-neutral-800/80 rounded-xl sm:rounded-2xl py-2 px-1.5 sm:p-2.5 text-center border border-[#e2eae0] dark:border-neutral-700/60 flex flex-col justify-center" title="Visited Continents">
                <span class="text-[9px] sm:text-[10px] text-[#6e826b] dark:text-neutral-400 font-bold uppercase tracking-wider truncate">Continents</span>
                <span id="stat-continents-count" class="text-sm sm:text-base font-extrabold text-[#63875e] dark:text-[#8ac282] mt-0.5">— / 7</span>
            </div>

            <!-- 3. Total Days Traveled -->
            <div class="bg-[#ebf0eb] dark:bg-neutral-800/80 rounded-xl sm:rounded-2xl py-2 px-1.5 sm:p-2.5 text-center border border-[#e2eae0] dark:border-neutral-700/60 flex flex-col justify-center">
                <span class="text-[9px] sm:text-[10px] text-[#6e826b] dark:text-neutral-400 font-bold uppercase tracking-wider truncate">Days</span>
                <span id="stat-total-days" class="text-sm sm:text-base font-extrabold text-[#63875e] dark:text-[#8ac282] mt-0.5">—</span>
            </div>

            <!-- 4. Countries Visited -->
            <div class="bg-[#ebf0eb] dark:bg-neutral-800/80 rounded-xl sm:rounded-2xl py-2 px-1.5 sm:p-2.5 text-center border border-[#e2eae0] dark:border-neutral-700/60 flex flex-col justify-center">
                <span class="text-[9px] sm:text-[10px] text-[#6e826b] dark:text-neutral-400 font-bold uppercase tracking-wider truncate">Countries</span>
                <span id="stat-visited-count" class="text-sm sm:text-base font-extrabold text-[#63875e] dark:text-[#8ac282] mt-0.5">—</span>
            </div>

            <!-- 5. Total Trips -->
            <div class="bg-[#ebf0eb] dark:bg-neutral-800/80 rounded-xl sm:rounded-2xl py-2 px-1.5 sm:p-2.5 text-center border border-[#e2eae0] dark:border-neutral-700/60 flex flex-col justify-center col-span-2 sm:col-span-1">
                <span class="text-[9px] sm:text-[10px] text-[#6e826b] dark:text-neutral-400 font-bold uppercase tracking-wider truncate">Trips</span>
                <span id="stat-total-trips" class="text-sm sm:text-base font-extrabold text-[#63875e] dark:text-[#8ac282] mt-0.5">—</span>
            </div>
        </div>

        <!-- SVG Map Container -->
        <div class="relative w-full aspect-[1010/540] max-h-[52vh] bg-[#f4f7f3] dark:bg-[#1a2119] rounded-xl sm:rounded-2xl overflow-hidden border border-[#e0e7df] dark:border-neutral-800 flex items-center justify-center group/map">
            <!-- Loading Skeleton Overlay -->
            <div id="map-loading-overlay" class="absolute inset-0 bg-[#f4f7f3]/80 dark:bg-[#1a2119]/80 backdrop-blur-xs flex flex-col items-center justify-center gap-2 z-10 transition-opacity duration-300">
                <div class="w-6 h-6 border-2 border-[#63875e] border-t-transparent rounded-full animate-spin"></div>
                <span class="text-xs text-[#6e826b] font-medium">Loading adventures...</span>
            </div>

            <!-- World SVG -->
            <svg
                id="world-map-svg"
                viewBox={WORLD_MAP_VIEWBOX}
                class="w-full h-full object-contain select-none transition-all"
                xmlns="http://www.w3.org/2000/svg"
            >
                {worldMapCountries.map((country) => (
                    <path
                        id={`country-${country.id}`}
                        d={country.d}
                        data-code={country.id}
                        data-name={country.name}
                        class="country-path fill-[#dce4db] dark:fill-[#2d372c] stroke-[#c8d4c6] dark:stroke-[#20281f] stroke-[0.4] transition-colors duration-200 hover:fill-[#b8ceb5] dark:hover:fill-[#3f503c] cursor-pointer"
                    />
                ))}
            </svg>

            <!-- Zoom / Landscape Button (Bottom Right) -->
            <button
                id="map-zoom-landscape-btn"
                type="button"
                aria-label="View Map in Landscape"
                title="View Map in Landscape"
                class="absolute bottom-2.5 right-2.5 z-20 bg-white/90 dark:bg-neutral-800/90 hover:bg-[#63875e] hover:text-white dark:hover:bg-[#63875e] text-[#121712] dark:text-white p-2 sm:px-2.5 sm:py-1.5 rounded-lg sm:rounded-xl shadow-md border border-neutral-200/80 dark:border-neutral-700 transition-all duration-200 hover:scale-105 active:scale-95 flex items-center justify-center gap-1.5 text-xs font-semibold backdrop-blur-md cursor-pointer"
            >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0-4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                </svg>
                <span class="hidden sm:inline text-[11px]">Landscape</span>
            </button>

            <!-- Floating Interactive Tooltip -->
            <div
                id="map-tooltip"
                class="pointer-events-none fixed hidden z-50 bg-[#121712]/95 text-white backdrop-blur-md px-3 py-2 rounded-xl shadow-xl border border-white/10 text-xs transition-opacity duration-150 transform -translate-x-1/2 -translate-y-full -mt-2"
            >
                <div class="flex items-center gap-2">
                    <img id="tooltip-flag" src="" alt="flag" class="w-5 h-3.5 rounded-xs object-cover shadow-xs hidden" />
                    <span id="tooltip-name" class="font-bold"></span>
                </div>
                <div id="tooltip-status" class="text-[11px] text-[#aadba3] font-medium mt-0.5"></div>
            </div>
        </div>

        <!-- Visited Countries Chips Section -->
        <div id="visited-chips-container" class="mt-2.5 pt-2 border-t border-neutral-200/60 dark:border-neutral-800">
            <div class="flex items-center justify-between mb-1.5">
                <h4 class="text-[11px] font-bold text-[#6e826b] dark:text-neutral-400 uppercase tracking-wider">Discovered Destinations</h4>
            </div>
            <div id="visited-chips-list" class="flex flex-wrap gap-1.5 max-h-20 sm:max-h-24 overflow-y-auto">
                <span class="text-xs text-neutral-400 italic">Loading destinations...</span>
            </div>
        </div>
    </div>
</section>

<!-- Fullscreen Landscape Modal -->
<div
    id="landscape-map-modal"
    class="fixed inset-0 z-50 bg-[#f4f7f3]/98 dark:bg-[#121712]/98 backdrop-blur-xl hidden flex-col justify-between p-3 md:p-6 transition-all duration-300"
>
    <!-- Modal Header -->
    <div class="w-full flex items-center justify-between gap-4 pb-2 border-b border-neutral-200/60 dark:border-neutral-800 shrink-0">
        <div class="flex items-center gap-2.5">
            <span class="text-base">🗺️</span>
            <div>
                <h4 class="text-sm font-bold text-[var(--text-color)]">World Map — Landscape View</h4>
                <p class="text-[11px] text-[#6e826b] dark:text-neutral-400 hidden sm:block">Rotate your device horizontally for the best experience</p>
            </div>
        </div>

        <button
            id="landscape-modal-close-btn"
            type="button"
            class="bg-neutral-200/80 hover:bg-neutral-300 dark:bg-neutral-800 dark:hover:bg-neutral-700 text-[var(--text-color)] px-3 py-1.5 rounded-full text-xs font-bold transition-all hover:scale-105 active:scale-95 cursor-pointer flex items-center gap-1"
        >
            <span>✕</span>
            <span>Close</span>
        </button>
    </div>

    <!-- Landscape SVG Viewport -->
    <div class="flex-1 w-full h-full flex items-center justify-center relative overflow-hidden py-2">
        <svg
            id="landscape-world-map-svg"
            viewBox={WORLD_MAP_VIEWBOX}
            class="w-full h-full max-h-[85vh] object-contain select-none transition-all"
            xmlns="http://www.w3.org/2000/svg"
        >
            {worldMapCountries.map((country) => (
                <path
                    id={`landscape-country-${country.id}`}
                    d={country.d}
                    data-code={country.id}
                    data-name={country.name}
                    class="country-path fill-[#dce4db] dark:fill-[#2d372c] stroke-[#c8d4c6] dark:stroke-[#20281f] stroke-[0.4] transition-colors duration-200 hover:fill-[#b8ceb5] dark:hover:fill-[#3f503c] cursor-pointer"
                />
            ))}
        </svg>
    </div>
</div>

<script>
    import { db, projectAuth } from "@/firebase/config";
    import { collection, getDocs } from "firebase/firestore";
    import {
        aggregateVisitedCountries,
        calculateTravelerSummary,
        type VisitedCountryStats
    } from "@/utils/travelerStats";
    import { escapeHtml } from "@/utils/escapeHtml";

    function initVisitedCountriesMap() {
        const section = document.getElementById("visited-map-section");
        if (!section || section.dataset.bound === "true") return;
        section.dataset.bound = "true";

        const rawUid = section.dataset.uid;
        if (!rawUid) return;
        const validUid: string = rawUid;

        const statVisitedCount = document.getElementById("stat-visited-count");
        const statWorldPercent = document.getElementById("stat-world-percent");
        const statTotalTrips = document.getElementById("stat-total-trips");
        const statContinentsCount = document.getElementById("stat-continents-count");
        const statTotalDays = document.getElementById("stat-total-days");

        const loadingOverlay = document.getElementById("map-loading-overlay");
        const svgMap = document.getElementById("world-map-svg") as SVGSVGElement | null;
        const landscapeSvgMap = document.getElementById("landscape-world-map-svg") as SVGSVGElement | null;
        const tooltip = document.getElementById("map-tooltip");
        const tooltipFlag = document.getElementById("tooltip-flag") as HTMLImageElement | null;
        const tooltipName = document.getElementById("tooltip-name");
        const tooltipStatus = document.getElementById("tooltip-status");
        const chipsList = document.getElementById("visited-chips-list");

        // Landscape Modal Elements
        const zoomLandscapeBtn = document.getElementById("map-zoom-landscape-btn");
        const landscapeModal = document.getElementById("landscape-map-modal");
        const landscapeCloseBtn = document.getElementById("landscape-modal-close-btn");

        function openLandscapeModal() {
            if (!landscapeModal) return;
            landscapeModal.classList.remove("hidden");
            landscapeModal.classList.add("flex");
            document.body.classList.add("overflow-hidden");

            // Attempt native screen orientation lock to landscape if available
            try {
                if (screen.orientation && (screen.orientation as any).lock) {
                    (screen.orientation as any).lock("landscape").catch(() => {});
                }
            } catch {}
        }

        function closeLandscapeModal() {
            if (!landscapeModal) return;
            landscapeModal.classList.add("hidden");
            landscapeModal.classList.remove("flex");
            document.body.classList.remove("overflow-hidden");

            // Unlock screen orientation
            try {
                if (screen.orientation && screen.orientation.unlock) {
                    screen.orientation.unlock();
                }
            } catch {}
        }

        zoomLandscapeBtn?.addEventListener("click", openLandscapeModal);
        landscapeCloseBtn?.addEventListener("click", closeLandscapeModal);

        window.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && landscapeModal && !landscapeModal.classList.contains("hidden")) {
                closeLandscapeModal();
            }
        });

        async function loadMapData() {
            try {
                await projectAuth.authStateReady();
                const userTripsRef = collection(db, "users", validUid, "trips");
                const tripsSnap = await getDocs(userTripsRef);

                const trips: any[] = [];
                tripsSnap.forEach((docSnap) => {
                    trips.push({ id: docSnap.id, ...docSnap.data() });
                });

                const summary = calculateTravelerSummary(trips);
                const visitedStats = aggregateVisitedCountries(trips);
                const visitedCodesMap = new Map<string, VisitedCountryStats>();
                visitedStats.forEach((stat) => visitedCodesMap.set(stat.code.toLowerCase(), stat));

                // Update Stats text
                if (statWorldPercent) statWorldPercent.textContent = `${summary.worldExploredPercentage}%`;
                if (statContinentsCount) {
                    statContinentsCount.textContent = `${summary.visitedContinentsCount} / ${summary.totalContinentsCount}`;
                    if (summary.visitedContinentsList.length > 0) {
                        statContinentsCount.parentElement?.setAttribute(
                            "title",
                            `Visited: ${summary.visitedContinentsList.join(", ")}`
                        );
                    }
                }
                if (statTotalDays) {
                    statTotalDays.textContent = summary.totalDaysTraveled === 1 ? "1 d" : `${summary.totalDaysTraveled} d`;
                }
                if (statVisitedCount) statVisitedCount.textContent = `${summary.visitedCountriesCount}`;
                if (statTotalTrips) statTotalTrips.textContent = `${summary.totalTripsCount}`;

                // Color visited paths on both standard and landscape SVGs
                document.querySelectorAll(".country-path").forEach((el) => {
                    const pathEl = el as SVGPathElement;
                    const code = (pathEl.dataset.code || "").toLowerCase();
                    const isVisited = visitedCodesMap.has(code);

                    if (isVisited) {
                        pathEl.classList.remove("fill-[#dce4db]", "dark:fill-[#2d372c]", "stroke-[#c8d4c6]", "dark:stroke-[#20281f]");
                        pathEl.classList.add("fill-[#63875e]", "dark:fill-[#7fb577]", "stroke-[#4a6b46]", "dark:stroke-[#91c788]", "stroke-[0.8]", "drop-shadow-xs");
                    }
                });

                // Render Chips
                if (chipsList) {
                    if (visitedStats.length === 0) {
                        chipsList.innerHTML = `
                            <p class="text-xs text-neutral-400 italic">No trips logged yet. Create your first trip and it will appear on the map.</p>
                        `;
                    } else {
                        chipsList.innerHTML = visitedStats.map((stat) => {
                            const safeCode = escapeHtml(stat.code);
                            const safeName = escapeHtml(stat.name);
                            const tripsLabel = stat.tripCount === 1 ? "1 trip" : `${stat.tripCount} trips`;
                            return `
                                <button
                                    type="button"
                                    data-country-code="${safeCode}"
                                    class="country-chip group flex items-center gap-1.5 bg-[#ebf0eb] hover:bg-[#63875e] dark:bg-neutral-800 hover:text-white dark:hover:bg-[#63875e] text-[#121712] dark:text-neutral-200 px-2.5 py-1 rounded-full text-xs font-semibold transition-all shadow-2xs hover:scale-105 active:scale-95 cursor-pointer"
                                >
                                    <img src="https://flagcdn.com/${safeCode}.svg" width="16" height="11" class="rounded-xs object-cover shadow-2xs" alt="${safeCode}" />
                                    <span>${safeName}</span>
                                    <span class="text-[10px] bg-black/10 dark:bg-white/10 group-hover:bg-white/20 px-1.5 py-0.2 rounded-full">${tripsLabel}</span>
                                </button>
                            `;
                        }).join("");

                        // Add chip hover interactions
                        chipsList.querySelectorAll(".country-chip").forEach((chip) => {
                            const btn = chip as HTMLButtonElement;
                            const code = btn.dataset.countryCode;
                            if (!code) return;

                            btn.addEventListener("mouseenter", () => {
                                const targetPath = document.getElementById(`country-${code}`);
                                const landscapePath = document.getElementById(`landscape-country-${code}`);
                                targetPath?.classList.add("fill-[#3f5c3a]", "dark:fill-[#9ee095]", "brightness-125");
                                landscapePath?.classList.add("fill-[#3f5c3a]", "dark:fill-[#9ee095]", "brightness-125");
                            });

                            btn.addEventListener("mouseleave", () => {
                                const targetPath = document.getElementById(`country-${code}`);
                                const landscapePath = document.getElementById(`landscape-country-${code}`);
                                targetPath?.classList.remove("fill-[#3f5c3a]", "dark:fill-[#9ee095]", "brightness-125");
                                landscapePath?.classList.remove("fill-[#3f5c3a]", "dark:fill-[#9ee095]", "brightness-125");
                            });
                        });
                    }
                }

                // Hide loading overlay
                if (loadingOverlay) {
                    loadingOverlay.classList.add("opacity-0", "pointer-events-none");
                    setTimeout(() => loadingOverlay.classList.add("hidden"), 300);
                }
            } catch (err) {
                console.error("Error loading visited countries map:", err);
                if (loadingOverlay) loadingOverlay.classList.add("hidden");
            }
        }

        // Setup Tooltip Mouse Tracking for both map views
        function bindTooltipEvents(targetSvg: SVGSVGElement | null) {
            if (!targetSvg || !tooltip) return;

            targetSvg.addEventListener("mousemove", (e: MouseEvent) => {
                const target = e.target as HTMLElement;
                if (target && target.classList.contains("country-path")) {
                    const code = (target.dataset.code || "").toLowerCase();
                    const name = target.dataset.name || code.toUpperCase();
                    const isVisited = target.classList.contains("fill-[#63875e]") || target.classList.contains("dark:fill-[#7fb577]");

                    if (tooltipFlag) {
                        tooltipFlag.src = `https://flagcdn.com/${code}.svg`;
                        tooltipFlag.classList.remove("hidden");
                    }
                    if (tooltipName) tooltipName.textContent = name;
                    if (tooltipStatus) {
                        tooltipStatus.textContent = isVisited ? "✅ Visited country" : "📍 Not visited yet";
                        tooltipStatus.className = isVisited ? "text-[11px] text-[#aadba3] font-medium mt-0.5" : "text-[11px] text-neutral-400 font-medium mt-0.5";
                    }

                    tooltip.style.left = `${e.clientX}px`;
                    tooltip.style.top = `${e.clientY}px`;
                    tooltip.classList.remove("hidden");
                } else {
                    tooltip.classList.add("hidden");
                }
            });

            targetSvg.addEventListener("mouseleave", () => {
                tooltip.classList.add("hidden");
            });
        }

        bindTooltipEvents(svgMap);
        bindTooltipEvents(landscapeSvgMap);

        loadMapData();
    }

    document.addEventListener("astro:page-load", initVisitedCountriesMap);
</script>
