---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const pathname = Astro.url.pathname;
const isEs = pathname === '/es' || pathname.startsWith('/es/');
const pathWithoutLang = isEs 
    ? (pathname.replace(/^\/es(\/|$)/, '/') || '/') 
    : pathname;

// Ensure pathWithoutLang always starts with /
const cleanPath = pathWithoutLang.startsWith('/') ? pathWithoutLang : `/${pathWithoutLang}`;
const enPath = cleanPath;
const esPath = cleanPath === '/' ? '/es' : `/es${cleanPath}`;
---

<div class="flex items-center bg-white/90 dark:bg-neutral-900/90 backdrop-blur-md p-1 rounded-full border border-neutral-200/80 dark:border-neutral-800 shadow-sm gap-0.5 select-none z-50">
    <!-- US Flag (English) -->
    <a
        href={enPath}
        title="English"
        aria-label="Switch to English"
        class={`flex items-center gap-1 px-2 py-1 rounded-full transition-all duration-200 cursor-pointer ${
            lang === 'en'
                ? 'bg-[#63875e] text-white shadow-2xs font-bold scale-[1.02]'
                : 'hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-600 dark:text-neutral-400 opacity-60 hover:opacity-100'
        }`}
    >
        <img
            src="https://flagcdn.com/us.svg"
            width="17"
            height="12"
            class="rounded-2xs object-cover shadow-2xs shrink-0"
            alt="US"
        />
        <span class="text-[10px] uppercase font-bold tracking-tight">US</span>
    </a>

    <!-- Spain Flag (Español) -->
    <a
        href={esPath}
        title="Español"
        aria-label="Cambiar a Español"
        class={`flex items-center gap-1 px-2 py-1 rounded-full transition-all duration-200 cursor-pointer ${
            lang === 'es'
                ? 'bg-[#63875e] text-white shadow-2xs font-bold scale-[1.02]'
                : 'hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-600 dark:text-neutral-400 opacity-60 hover:opacity-100'
        }`}
    >
        <img
            src="https://flagcdn.com/es.svg"
            width="17"
            height="12"
            class="rounded-2xs object-cover shadow-2xs shrink-0"
            alt="ES"
        />
        <span class="text-[10px] uppercase font-bold tracking-tight">ES</span>
    </a>
</div>
