---
import { Label } from "@/components/starwind/label";
import { Input } from "@/components/starwind/input";
import { Button } from "@/components/starwind/button";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="flex flex-col pt-5 pl-4 pr-4 gap-6">
    <h2 class="text-[22px] font-extrabold">{t('auth.signinTitle')}</h2>
    <form class="flex flex-col" id="login-account">
        <Label class="mb-2 font-medium" for="signin-email">{t('auth.email')}</Label>
        <Input name="email" id="signin-email" type="email" placeholder={t('auth.emailPlaceholder')} class="rounded-[12px] mb-6 h-14 p-4 text-[16px] text-[#63875E] bg-[#EBF0EB]" />
        <Label class="mb-2 font-medium" for="signin-password">{t('auth.password')}</Label>
        <div class="relative flex items-center mb-6">
            <Input name="password" id="signin-password" type="password" placeholder={t('auth.passwordPlaceholder')} class="rounded-[12px] h-14 p-4 pr-12 text-[16px] text-[#63875E] bg-[#EBF0EB] w-full" />
            <button
                type="button"
                id="signin-toggle-password"
                class="absolute right-4 text-[#63875E] hover:text-[#4a6546] transition-colors focus:outline-none cursor-pointer flex items-center justify-center p-1"
                aria-label={t('auth.togglePassword')}
            >
                <svg id="signin-eye-icon" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <svg id="signin-eye-off-icon" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                </svg>
            </button>
        </div>
        <Button type="submit" variant="Form">{t('auth.signinButton')}</Button>
    </form>
</section>

<script>
    import { projectAuth } from "@/firebase/config";
    import { signInWithEmailAndPassword } from "firebase/auth";
    import { showToast } from "@/utils/toast";

    function initSignInForm() {
        const loginForm = document.querySelector("#login-account") as HTMLFormElement;
        if (!loginForm || loginForm.dataset.bound === "true") return;
        loginForm.dataset.bound = "true";

        const formEmail = document.getElementById("signin-email") as HTMLInputElement;
        const formPassword = document.getElementById("signin-password") as HTMLInputElement;
        const togglePasswordBtn = document.getElementById("signin-toggle-password");
        const eyeIcon = document.getElementById("signin-eye-icon");
        const eyeOffIcon = document.getElementById("signin-eye-off-icon");

        const isEs = window.location.pathname.startsWith("/es");

        togglePasswordBtn?.addEventListener("click", () => {
            const isPassword = formPassword.type === "password";
            formPassword.type = isPassword ? "text" : "password";
            eyeIcon?.classList.toggle("hidden", isPassword);
            eyeOffIcon?.classList.toggle("hidden", !isPassword);
        });

        loginForm.addEventListener("submit", async (e) => {
            e.preventDefault();
            try {
                // Auth happens client-side so the browser keeps Firebase Auth state
                const userCredential = await signInWithEmailAndPassword(
                    projectAuth,
                    formEmail.value,
                    formPassword.value,
                );

                // Send ID token to server to create a session cookie
                const idToken = await userCredential.user.getIdToken();
                const res = await fetch("/api/session", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ idToken }),
                });

                if (!res.ok) {
                    throw new Error("Failed to create session");
                }

                window.location.href = isEs ? "/es/authenticated/trips" : "/authenticated/trips";
            } catch (err: unknown) {
                console.error("Sign-in error:", err);
                const message = err instanceof Error ? err.message : (isEs ? "Error al iniciar sesión" : "Sign-in error");
                showToast(message, "error");
            }
        });
    }

    document.addEventListener("astro:page-load", initSignInForm);
</script>
