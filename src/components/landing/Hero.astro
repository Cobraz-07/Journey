---
import { Button } from "@/components/starwind/button";
import { getLangFromUrl, useTranslations, getLocalizedPath } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="flex flex-col items-center my-4 max-w-[420px] mx-auto">
    <div id="hero-title-container" class="mx-4 mt-6 mb-3 text-center">
        <h2 class="text-[32px] font-bold" set:html={t('hero.title')}></h2>
    </div>
    <div id="hero-subtitle-container" class="mx-4 mt-1 mb-3 text-center">
        <p class="text-[16px] w-19/20 m-auto">{t('hero.subtitle')}</p>
    </div>
    <div id="hero-button-container" class="mx-4 my-3 text-center">
        <Button href={getLocalizedPath('/register', lang)} variant="CTA" class="w-[132px] h-[48px]">{t('hero.cta')}</Button>
    </div>
</section>
