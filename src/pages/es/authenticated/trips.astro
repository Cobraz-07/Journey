---
import TitleSimple from "@/components/global/headers/TitleSimple.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AppFooter from "@/components/global/footers/AppFooter.astro";
import TripList from "@/components/authenticated/trips_page/TripList.astro";
import TripListHeader from "@/components/authenticated/trips_page/TripListHeader.astro";
import TripListForm from "@/components/authenticated/trips_page/TripListForm.astro";
import { getLangFromUrl, useTranslations, getLocalizedPath } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const toggled = "bg-[var(--brand-color)]";
const uid = Astro.locals.uid;
if (!uid) return Astro.redirect(getLocalizedPath("/signin", lang));
---

<BaseLayout title={`Journey | ${t('nav.trips')}`}>
    <TitleSimple title="Journey" />
    <TripListHeader />
    <TripListForm uid={uid} />
    <div class="pb-24">
        <TripList uid={uid} />
    </div>
    <AppFooter iconStateHome={toggled} />
</BaseLayout>
