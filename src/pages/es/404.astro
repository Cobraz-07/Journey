---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TitleSimple from "@/components/global/headers/TitleSimple.astro";
import { getLangFromUrl, useTranslations, getLocalizedPath } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={`Journey | ${t('notFound.title')}`}>
    <TitleSimple title="Journey" />
    <main class="w-full max-w-md mx-auto px-6 py-16 flex flex-col items-center text-center gap-4">
        <div class="w-16 h-16 rounded-full bg-[#ebf0eb] dark:bg-neutral-800 flex items-center justify-center text-3xl mb-2">
            🧭
        </div>
        <h1 class="text-2xl font-extrabold text-[var(--text-color)]">{t('notFound.title')}</h1>
        <p class="text-sm text-[var(--lt-text-color)] leading-relaxed">
            {t('notFound.desc')}
        </p>
        <a
            href={getLocalizedPath('/', lang)}
            class="mt-4 px-6 py-2.5 rounded-full text-xs font-bold bg-[#63875e] hover:bg-[#52704e] text-white transition-all shadow-sm active:scale-95"
        >
            {t('notFound.returnHome')}
        </a>
    </main>
</BaseLayout>
