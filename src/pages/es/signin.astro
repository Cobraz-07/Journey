---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BackBTN from "@/components/global/headers/BackBTN.astro";
import TitleSimple from "@/components/global/headers/TitleSimple.astro";
import SignInForm from "@/components/forms/SignInForm.astro";
import BackLink from "@/components/forms/BackLink.astro";
import { getLangFromUrl, useTranslations, getLocalizedPath } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={`Journey | ${t('auth.signinButton')}`}>
    <BackBTN href={getLocalizedPath('/', lang)} />
    <TitleSimple title="Journey" />
    <SignInForm />
    <BackLink href={getLocalizedPath('/register', lang)} text={t('auth.noAccount')} />
</BaseLayout>
