---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAdminDb } from "@/firebase/server";
import { isValidShareToken } from "@/utils/shareToken";
import { formatDate } from "@/utils/formatDate";
import type { TripPhoto } from "@/firebase/storageService";
import TripPhotoLightbox from "@/components/authenticated/trips_page/TripPhotoLightbox.astro";
import { getLangFromUrl, useTranslations, getLocalizedPath } from "@/i18n/utils";

interface JournalEntry {
    id: string;
    title?: string;
    description?: string;
    date?: string;
    imageUrl?: string;
    imageStoragePath?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { shareToken } = Astro.params;

if (!shareToken || !isValidShareToken(shareToken)) {
    return Astro.redirect(getLocalizedPath("/404", lang));
}

const adminDb = await getAdminDb();
const publicTripSnap = await adminDb.collection("publicTrips").doc(shareToken).get();

if (!publicTripSnap.exists) {
    // Render 404 if not found or revoked
    return Astro.redirect(getLocalizedPath("/404", lang));
}

const publicInfo = publicTripSnap.data();
const { uid, tripId } = publicInfo ?? {};

if (!uid || !tripId) {
    return Astro.redirect(getLocalizedPath("/404", lang));
}

// Fetch trip details
const tripSnap = await adminDb.collection("users").doc(uid).collection("trips").doc(tripId).get();

if (!tripSnap.exists || !tripSnap.data()?.isPublic) {
    return Astro.redirect(getLocalizedPath("/404", lang));
}

const tripData = tripSnap.data()!;

// Fetch owner profile for display name
let authorName = t('showcase.traveler');
try {
    const userSnap = await adminDb.collection("users").doc(uid).get();
    if (userSnap.exists) {
        const uData = userSnap.data();
        const rawEmail = uData?.email;
        if (rawEmail && rawEmail.includes("@")) {
            authorName = rawEmail.split("@")[0].toUpperCase();
        }
    }
} catch {}

// Fetch Journals
const journalsSnap = await adminDb
    .collection("users")
    .doc(uid)
    .collection("trips")
    .doc(tripId)
    .collection("journal")
    .orderBy("date", "desc")
    .get();

const journals: JournalEntry[] = journalsSnap.docs.map((docSnap) => ({
    id: docSnap.id,
    ...(docSnap.data() as Omit<JournalEntry, "id">),
}));

// Fetch Photos
const photosSnap = await adminDb
    .collection("users")
    .doc(uid)
    .collection("trips")
    .doc(tripId)
    .collection("photos")
    .orderBy("createdAt", "desc")
    .get();

const photos: TripPhoto[] = photosSnap.docs.map((docSnap) => ({
    id: docSnap.id,
    ...(docSnap.data() as Omit<TripPhoto, "id">),
}));

const pageTitle = `${tripData.title ?? "Travel Showcase"} | Journey`;
const pageDescription = tripData.description || `Explore ${tripData.title} by ${authorName} on Journey.`;
const ogImage = tripData.coverUrl || (photos.length > 0 ? photos[0].url : "https://journey.app/og-image.jpg");
---

<BaseLayout title={pageTitle}>
    <!-- Custom Meta Tags for Rich Social Previews (WhatsApp, iMessage, Twitter, etc.) -->
    <Fragment slot="head">
        <meta name="description" content={pageDescription} />
        <meta property="og:type" content="article" />
        <meta property="og:title" content={`${tripData.title} — Travel Showcase`} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:image" content={ogImage} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={`${tripData.title} — Travel Showcase`} />
        <meta name="twitter:description" content={pageDescription} />
        <meta name="twitter:image" content={ogImage} />
    </Fragment>

    <!-- Public Showcase Top Navigation Bar -->
    <header class="w-full border-b border-neutral-200/70 dark:border-neutral-800 bg-[#f2f0eb]/90 dark:bg-[#121712]/90 backdrop-blur-md sticky top-0 z-30 px-4 py-3 flex items-center justify-between max-w-4xl mx-auto">
        <a href={getLocalizedPath("/", lang)} class="flex items-center gap-2 text-[var(--text-color)] hover:opacity-80 transition-opacity">
            <span class="text-xl font-black tracking-tight text-[#63875e]">Journey</span>
        </a>

        <div class="flex items-center gap-2">
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 flex items-center gap-1.5 shadow-2xs">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                {t('showcase.publicBadge')}
            </span>
            <a href={getLocalizedPath("/register", lang)} class="hidden sm:inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-xs font-bold bg-[#63875e] hover:bg-[#52704e] text-white transition-all shadow-xs active:scale-95">
                {t('showcase.join')}
            </a>
        </div>
    </header>

    <main class="w-full max-w-4xl mx-auto px-4 py-6">
        <!-- Hero Banner with Cover Photo -->
        <section class="relative w-full rounded-3xl overflow-hidden border border-neutral-200/80 dark:border-neutral-800 shadow-sm mb-8 bg-gradient-to-tr from-[#63875e]/20 to-[#aadba3]/30 min-h-[220px] sm:min-h-[280px] flex items-end">
            {tripData.coverUrl && (
                <img
                    src={tripData.coverUrl}
                    alt={tripData.title ?? "Trip Cover"}
                    class="absolute inset-0 w-full h-full object-cover"
                />
            )}

            <!-- Gradient Overlay -->
            <div class={`absolute inset-0 ${tripData.coverUrl ? "bg-gradient-to-t from-black/80 via-black/30 to-transparent" : "bg-gradient-to-t from-black/20 to-transparent"}`}></div>

            <!-- Country Flag Badge -->
            {tripData.countryCode && (
                <div class="absolute top-4 left-4 z-10 bg-white/95 dark:bg-black/80 backdrop-blur-md px-3 py-1.5 rounded-xl flex items-center gap-2 shadow-sm">
                    <img src={`https://flagcdn.com/${tripData.countryCode}.svg`} width="22" class="h-4.5 rounded-xs object-cover" alt={tripData.countryCode} />
                    <span class="text-xs font-bold text-neutral-800 dark:text-neutral-200">{tripData.country ?? ""}</span>
                </div>
            )}

            <!-- Hero Details -->
            <div class="relative z-10 p-6 sm:p-8 w-full">
                <div class="flex items-center gap-2 mb-2">
                    <span class="text-xs font-semibold px-2.5 py-0.5 rounded-md bg-white/20 text-white backdrop-blur-md border border-white/20">
                        📅 {formatDate(tripData.startDate)} — {formatDate(tripData.endDate)}
                    </span>
                    <span class="text-xs font-semibold text-white/80">
                        {t('showcase.by')} <span class="text-white font-bold">{authorName}</span>
                    </span>
                </div>

                <h1 class={`text-2xl sm:text-4xl font-black tracking-tight mb-2 ${tripData.coverUrl ? "text-white drop-shadow-md" : "text-[var(--text-color)]"}`}>
                    {tripData.title ?? (lang === 'es' ? "Escaparate de Aventura" : "Adventure Showcase")}
                </h1>

                {tripData.description && (
                    <p class={`text-sm sm:text-base max-w-2xl leading-relaxed ${tripData.coverUrl ? "text-white/90 drop-shadow" : "text-[var(--lt-text-color)]"}`}>
                        {tripData.description}
                    </p>
                )}
            </div>
        </section>

        <!-- Photo Gallery Section -->
        {photos.length > 0 && (
            <section class="mb-10">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-lg font-bold text-[var(--text-color)] flex items-center gap-2">
                        <span>📸</span> {t('showcase.galleryTitle')}
                    </h2>
                    <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-[#ebf0eb] dark:bg-neutral-800 text-[#63875e] dark:text-[#8ac282]">
                        {photos.length} {photos.length === 1 ? t('showcase.photoSingle') : t('showcase.photoPlural')}
                    </span>
                </div>

                <div id="public-photo-gallery" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
                    {photos.map((photo, idx) => (
                        <div
                            data-photo-index={idx}
                            class="public-photo-card group relative rounded-2xl overflow-hidden aspect-square bg-neutral-100 dark:bg-neutral-800 border border-neutral-200/60 dark:border-neutral-800 shadow-2xs hover:shadow-md cursor-pointer transition-all hover:scale-[1.02]"
                            style={photo.blurDataUrl ? `background-image: url('${photo.blurDataUrl}'); background-size: cover;` : ""}
                        >
                            <img
                                src={photo.thumbnailUrl || photo.url}
                                alt={photo.caption || (lang === 'es' ? "Foto del viaje" : "Trip Photo")}
                                loading="lazy"
                                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                            />
                            {photo.caption && (
                                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-3">
                                    <p class="text-white text-xs font-medium truncate drop-shadow">{photo.caption}</p>
                                </div>
                            )}
                        </div>
                    ))}
                </div>
            </section>
        )}

        <!-- Journal / Itinerary Section -->
        <section class="mb-12">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-bold text-[var(--text-color)] flex items-center gap-2">
                    <span>📖</span> {t('showcase.journalTitle')}
                </h2>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-[#ebf0eb] dark:bg-neutral-800 text-[#63875e] dark:text-[#8ac282]">
                    {journals.length} {journals.length === 1 ? t('showcase.entrySingle') : t('showcase.entryPlural')}
                </span>
            </div>

            {journals.length === 0 ? (
                <div class="flex flex-col items-center justify-center p-8 border-2 border-dashed border-neutral-200 dark:border-neutral-800 rounded-3xl bg-white/40 dark:bg-neutral-900/30 text-center gap-1.5">
                    <p class="text-sm font-semibold text-[var(--text-color)]">{t('showcase.noJournals')}</p>
                    <p class="text-xs text-[var(--lt-text-color)]">{t('showcase.noJournalsDesc')}</p>
                </div>
            ) : (
                <div class="flex flex-col gap-4">
                    {journals.map((entry) => (
                        <article class="bg-white/70 dark:bg-neutral-900/60 backdrop-blur-md rounded-2xl p-5 border border-neutral-200/70 dark:border-neutral-800 shadow-xs flex flex-col gap-3">
                            <div class="flex items-start justify-between gap-2">
                                <div>
                                    <h3 class="font-bold text-base text-[var(--text-color)]">{entry.title || (lang === 'es' ? "Nota del diario" : "Journal Note")}</h3>
                                    <p class="text-xs font-medium text-[#6e826b] dark:text-neutral-400 mt-0.5">
                                        📅 {formatDate(entry.date)}
                                    </p>
                                </div>
                            </div>

                            {entry.description && (
                                <p class="text-sm text-[var(--lt-text-color)] whitespace-pre-line leading-relaxed">
                                    {entry.description}
                                </p>
                            )}

                            {entry.imageUrl && (
                                <div
                                    class="public-journal-img mt-1 max-w-md rounded-xl overflow-hidden border border-neutral-200 dark:border-neutral-800 shadow-xs cursor-pointer group"
                                    data-journal-img={entry.imageUrl}
                                    data-journal-title={entry.title || (lang === 'es' ? "Foto del diario" : "Journal Photo")}
                                >
                                    <img
                                        src={entry.imageUrl}
                                        alt={entry.title || (lang === 'es' ? "Foto del diario" : "Journal Photo")}
                                        class="w-full max-h-72 object-cover transition-transform duration-300 group-hover:scale-105"
                                        loading="lazy"
                                    />
                                </div>
                            )}
                        </article>
                    ))}
                </div>
            )}
        </section>

        <!-- Footer Call-to-Action -->
        <section class="bg-gradient-to-br from-[#ebf0eb] to-[#e0e9df] dark:from-neutral-900 dark:to-neutral-800/80 rounded-3xl p-6 sm:p-8 text-center border border-neutral-200 dark:border-neutral-700/60 shadow-xs">
            <h3 class="text-lg sm:text-xl font-black text-[var(--text-color)] mb-2">
                {t('showcase.ctaTitle')}
            </h3>
            <p class="text-xs sm:text-sm text-[var(--lt-text-color)] max-w-md mx-auto mb-5">
                {t('showcase.ctaDesc')}
            </p>
            <div class="flex items-center justify-center gap-3">
                <a
                    href={getLocalizedPath("/register", lang)}
                    class="px-5 py-2.5 rounded-full text-xs font-bold bg-[#63875e] hover:bg-[#52704e] text-white transition-all shadow-md hover:scale-105 active:scale-95"
                >
                    {t('showcase.createAccount')}
                </a>
                <a
                    href={getLocalizedPath("/", lang)}
                    class="px-4 py-2.5 rounded-full text-xs font-semibold bg-white dark:bg-neutral-800 text-[var(--text-color)] border border-neutral-200 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-700 transition-all active:scale-95"
                >
                    {t('showcase.learnMore')}
                </a>
            </div>
        </section>
    </main>

    <!-- Public Lightbox Component -->
    <TripPhotoLightbox />
</BaseLayout>

<script is:inline define:vars={{ rawPhotos: photos }}>
    function initPublicShowcase() {
        const galleryCards = document.querySelectorAll(".public-photo-card");
        
        galleryCards.forEach((card) => {
            card.addEventListener("click", () => {
                const idxStr = card.getAttribute("data-photo-index");
                const startIndex = idxStr ? parseInt(idxStr, 10) : 0;

                window.dispatchEvent(
                    new CustomEvent("open-trip-lightbox", {
                        detail: {
                            photos: rawPhotos,
                            startIndex,
                        },
                    })
                );
            });
        });

        // Journal image click to lightbox
        document.querySelectorAll(".public-journal-img").forEach((jImg) => {
            jImg.addEventListener("click", () => {
                const url = jImg.getAttribute("data-journal-img");
                const title = jImg.getAttribute("data-journal-title");
                if (!url) return;

                window.dispatchEvent(
                    new CustomEvent("open-trip-lightbox", {
                        detail: {
                            photos: [{ id: "journal_img", url, storagePath: "", caption: title, createdAt: "" }],
                            startIndex: 0,
                        },
                    })
                );
            });
        });
    }

    document.addEventListener("astro:page-load", initPublicShowcase);
    initPublicShowcase();
</script>
