---
import TitleSimple from "@/components/global/headers/TitleSimple.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import User from "@/components/authenticated/account_page/User.astro";
import SettingsAccordion from "@/components/authenticated/account_page/SettingsAccordion.astro";
import InstallPwaButton from "@/components/authenticated/account_page/InstallPwaButton.astro";
import AppFooter from "@/components/global/footers/AppFooter.astro";
import SignOutButton from "@/components/authenticated/account_page/SignOutButton.astro";

const toggled = "bg-[var(--brand-color)]";
const email = Astro.locals.userEmail;
const uid = Astro.locals.uid;
if (!uid) return Astro.redirect("/signin");
---

<BaseLayout title="Journey | Account">
    <div class="flex flex-col min-h-svh pb-28 max-w-md mx-auto w-full px-4">
        <TitleSimple title="Settings" />
        <User email={email} uid={uid} />
        <SettingsAccordion />
        <InstallPwaButton />
        <SignOutButton />
    </div>
    <AppFooter iconStateUser={toggled} />
</BaseLayout>
