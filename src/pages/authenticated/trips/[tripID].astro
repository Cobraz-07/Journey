---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAdminDb } from "@/firebase/server";
import TitleSimple from "@/components/global/headers/TitleSimple.astro";
import BackBTN from "@/components/global/headers/BackBTN.astro";
import TripJournalHeader from "@/components/authenticated/trips_page/TripJournalHeader.astro";
import TripJournalForm from "@/components/authenticated/trips_page/TripJournalForm.astro";
import TripJournalList from "@/components/authenticated/trips_page/TripJournalList.astro";
import TripPhotoGallery from "@/components/authenticated/trips_page/TripPhotoGallery.astro";
import TripShareModal from "@/components/authenticated/trips_page/TripShareModal.astro";
import { DialogTrigger } from "@/components/starwind/dialog";
import { Icon } from "astro-icon/components";
import { formatDate } from "@/utils/formatDate";
import { getLangFromUrl, useTranslations, getLocalizedPath } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const uid = Astro.locals.uid;
if (!uid) return Astro.redirect(getLocalizedPath("/signin", lang));

const { tripID } = Astro.params;
const adminDb = await getAdminDb();
const tripSnap = await adminDb
    .collection("users")
    .doc(uid)
    .collection("trips")
    .doc(tripID ?? "unknown_trip")
    .get();

if (!tripSnap.exists) {
    return Astro.redirect(getLocalizedPath("/authenticated/trips", lang));
}

const tripData = tripSnap.data();
---

<BaseLayout id="layout" title={`Journey | ${tripData?.title ?? tripID}`}>
    <BackBTN href={getLocalizedPath("/authenticated/trips", lang)} />
    <div class="flex items-center gap-1.5 absolute top-4 right-4 z-20">
        <DialogTrigger for="trip-share-dialog" class="p-1.5 rounded-full hover:bg-neutral-200/60 dark:hover:bg-neutral-800 text-[#63875e] transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer flex items-center justify-center" title={t('tripDetail.shareTitle')}>
            <Icon class="w-6 h-6" name="share" />
        </DialogTrigger>
        <button data-uid={uid} data-id={tripID} id="delete-trip-btn" class="p-1 rounded-full hover:bg-neutral-200/60 dark:hover:bg-neutral-800 transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer flex items-center justify-center text-red-500" title={t('tripDetail.deleteTitle')}><Icon class="w-7.5 h-7.5" name="delete" /></button>
    </div>
    <TitleSimple title={t('tripDetail.title')} />

    <!-- Trip Hero / Cover Photo Banner -->
    <section class="flex flex-col mt-14 w-full px-6">
        <div class="relative w-full rounded-2xl overflow-hidden border border-neutral-200 dark:border-neutral-800 shadow-sm mb-6 bg-gradient-to-tr from-[#63875e]/20 to-[#aadba3]/30 min-h-[160px] flex items-end">
            <!-- Cover image if present -->
            <img 
                id="trip-cover-img" 
                src={tripData?.coverUrl || ""} 
                alt="Cover photo" 
                transition:name={`trip-cover-${tripID}`}
                class={`absolute inset-0 w-full h-full object-cover ${tripData?.coverUrl ? "" : "hidden"}`} 
            />

            <!-- Dark overlay when cover image is present -->
            <div id="cover-overlay" class={`absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent ${tripData?.coverUrl ? "" : "hidden"}`}></div>

            <!-- Country Flag Badge -->
            {tripData?.countryCode && (
                <div class="absolute top-3 left-3 z-10 bg-white/90 dark:bg-black/80 backdrop-blur-md px-2.5 py-1 rounded-lg flex items-center gap-1.5 shadow-sm">
                    <img src={`https://flagcdn.com/${tripData.countryCode}.svg`} width="20" class="h-4 rounded-sm object-cover" alt={tripData.countryCode} />
                    <span class="text-xs font-semibold text-neutral-800 dark:text-neutral-200">{tripData?.country || ""}</span>
                </div>
            )}

            <!-- Change Cover Photo Button -->
            <div class="absolute top-3 right-3 z-10">
                <input id="cover-file-input" type="file" accept="image/*" class="hidden" />
                <button 
                    id="change-cover-btn" 
                    type="button" 
                    class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-black/60 hover:bg-black text-white backdrop-blur-md transition-all shadow cursor-pointer active:scale-95"
                    title={tripData?.coverUrl ? t('tripDetail.changeCover') : t('tripDetail.addCover')}
                >
                    <Icon name="image" class="w-3.5 h-3.5" />
                    <span id="change-cover-text">{tripData?.coverUrl ? t('tripDetail.changeCover') : t('tripDetail.addCover')}</span>
                </button>
            </div>

            <!-- Trip Header Details -->
            <div class="relative z-10 p-5 pt-16 w-full">
                <h2 
                    id="trip-title-header" 
                    transition:name={`trip-title-${tripID}`}
                    class={`text-2xl sm:text-3xl font-extrabold tracking-tight leading-tight mb-2 ${tripData?.coverUrl ? "text-white drop-shadow-md" : "text-[var(--text-color)]"}`}
                >
                    {tripData?.title ?? (lang === 'es' ? "Viaje sin título" : "Unnamed Trip")}
                </h2>
                <p id="trip-desc-header" class={`text-sm leading-relaxed mb-3 max-w-2xl line-clamp-3 ${tripData?.coverUrl ? "text-white/90 drop-shadow" : "text-[var(--lt-text-color)]"}`}>
                    {tripData?.description ?? t('tripDetail.noDescription')}
                </p>
                <div class="flex items-center gap-2">
                    <span class={`text-xs font-semibold px-2 py-0.5 rounded-md ${tripData?.coverUrl ? "bg-black/40 text-white/90 backdrop-blur-sm" : "bg-[#ebf0eb] text-[#63875e]"}`}>
                        📅 {formatDate(tripData?.startDate)} — {formatDate(tripData?.endDate)}
                    </span>
                </div>
            </div>
        </div>
    </section>

    <!-- Trip Photos Gallery Component -->
    <TripPhotoGallery uid={uid} tripID={tripID ?? "unknown_trip"} />

    <hr class="w-9/10 mx-auto my-4 border-neutral-200 dark:border-neutral-800" />

    <!-- Trip Journal Section -->
    <TripJournalHeader />
    <TripJournalForm uid={uid} tripID={tripID} />
    <TripJournalList uid={uid} tripID={tripID} />

    <!-- Trip Share Modal -->
    <TripShareModal uid={uid} tripID={tripID ?? "unknown_trip"} />
</BaseLayout>

<script>
    import { compressImageToWebP } from "@/utils/imageCompressor";
    import { uploadTripCover, deleteEntireTrip } from "@/firebase/storageService";
    import { showToast } from "@/utils/toast";
    import { db } from "@/firebase/config";
    import { doc, getDoc, setDoc } from "firebase/firestore";

    function initTripDetails() {
        const deleteBtn = document.getElementById("delete-trip-btn");
        if (!deleteBtn || deleteBtn.dataset.bound === "true") return;
        deleteBtn.dataset.bound = "true";

        const isEs = window.location.pathname.startsWith("/es");

        const uid = deleteBtn.dataset.uid;
        const tripID = deleteBtn.dataset.id;

        deleteBtn.addEventListener("click", async () => {
            if (!uid || !tripID) return;
            const confirmMsg = isEs
                ? "¿Estás seguro de que deseas eliminar este viaje por completo? Se eliminarán todas las fotos y diarios asociados."
                : "Are you sure you want to delete this trip entirely? All photos and journal entries will be removed.";
            if (confirm(confirmMsg)) {
                deleteBtn.setAttribute("disabled", "true");
                try {
                    await deleteEntireTrip(uid, tripID);
                    window.location.href = isEs ? "/es/authenticated/trips" : "/authenticated/trips";
                } catch (err) {
                    console.error("Error deleting trip:", err);
                    showToast(isEs ? "Error al eliminar el viaje." : "Failed to delete the trip.", "error");
                    deleteBtn.removeAttribute("disabled");
                }
            }
        });

        // Cover Photo Upload Logic
        const changeCoverBtn = document.getElementById("change-cover-btn");
        const changeCoverText = document.getElementById("change-cover-text");
        const coverFileInput = document.getElementById("cover-file-input") as HTMLInputElement;
        const coverImg = document.getElementById("trip-cover-img") as HTMLImageElement;
        const coverOverlay = document.getElementById("cover-overlay") as HTMLDivElement;
        const titleHeader = document.getElementById("trip-title-header");
        const descHeader = document.getElementById("trip-desc-header");

        changeCoverBtn?.addEventListener("click", () => coverFileInput?.click());

        coverFileInput?.addEventListener("change", async () => {
            if (!coverFileInput.files?.[0] || !uid || !tripID) return;
            const rawFile = coverFileInput.files[0];

            try {
                if (changeCoverText) changeCoverText.textContent = isEs ? "Comprimiendo..." : "Compressing...";
                const compressed = await compressImageToWebP(rawFile, { maxWidth: 2000, maxHeight: 1200, quality: 0.88 });
                
                if (changeCoverText) changeCoverText.textContent = isEs ? "Subiendo..." : "Uploading...";
                
                const tripDocRef = doc(db, "users", uid, "trips", tripID);
                const tripSnap = await getDoc(tripDocRef);
                const oldCoverStoragePath = tripSnap.exists() ? tripSnap.data()?.coverStoragePath : undefined;

                const coverResult = await uploadTripCover(uid, tripID, compressed.file, oldCoverStoragePath);
                await setDoc(tripDocRef, {
                    coverUrl: coverResult.url,
                    coverStoragePath: coverResult.storagePath,
                }, { merge: true });

                // Update UI instantly
                coverImg.src = coverResult.url;
                coverImg.classList.remove("hidden");
                coverOverlay.classList.remove("hidden");

                titleHeader?.classList.remove("text-[var(--text-color)]");
                titleHeader?.classList.add("text-white", "drop-shadow-md");

                descHeader?.classList.remove("text-[var(--lt-text-color)]");
                descHeader?.classList.add("text-white/90", "drop-shadow");

                if (changeCoverText) changeCoverText.textContent = isEs ? "Cambiar portada" : "Change cover";
                showToast(isEs ? "Foto de portada actualizada con éxito." : "Cover photo updated successfully.", "success");
            } catch (err) {
                console.error("Error uploading cover photo:", err);
                showToast(isEs ? "Error al actualizar la foto de portada." : "Failed to update the cover photo.", "error");
                if (changeCoverText) changeCoverText.textContent = isEs ? "Cambiar portada" : "Change cover";
            }
        });
    }

    document.addEventListener("astro:page-load", initTripDetails);
</script>
