rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only access their own document (keyed by email)
    match /users/{email} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == email;

      // Trips subcollection — same owner rule
      match /trips/{tripId} {
        allow read, write: if request.auth != null
                           && request.auth.token.email == email;

        // Journal entries within a trip — same owner rule
        match /journal/{journalId} {
          allow read, write: if request.auth != null
                             && request.auth.token.email == email;
        }

        // Photos subcollection within a trip — same owner rule
        match /photos/{photoId} {
          allow read, write: if request.auth != null
                             && request.auth.token.email == email;
        }
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
