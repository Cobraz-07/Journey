rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check that the user is authenticated and owns this path by immutable UID
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // User profile document
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                   && request.resource.data.keys().hasOnly(['email', 'tripCounter', 'createdAt', 'updatedAt'])
                   && (request.resource.data.email is string || !('email' in request.resource.data));
    }

    // Trips subcollection
    match /users/{uid}/trips/{tripId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasOnly([
                         'title', 'description', 'startDate', 'endDate',
                         'country', 'countryCode', 'coverUrl', 'coverStoragePath', 'createdAt'
                       ])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 100
                    && (!('description' in request.resource.data) || request.resource.data.description == null || request.resource.data.description.size() <= 1000);
      allow update: if isOwner(uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'title', 'description', 'startDate', 'endDate',
                         'country', 'countryCode', 'coverUrl', 'coverStoragePath', 'createdAt'
                       ])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 100
                    && (!('description' in request.resource.data) || request.resource.data.description == null || request.resource.data.description.size() <= 1000);
      allow delete: if isOwner(uid);
    }

    // Photos subcollection under trips
    match /users/{uid}/trips/{tripId}/photos/{photoId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                   && request.resource.data.keys().hasOnly([
                        'id', 'url', 'storagePath', 'thumbnailUrl', 'thumbnailStoragePath',
                        'blurDataUrl', 'caption', 'createdAt', 'size', 'thumbnailSize',
                        'width', 'height'
                      ])
                   && request.resource.data.url is string
                   && request.resource.data.storagePath is string
                   && (!('caption' in request.resource.data) || request.resource.data.caption == null || request.resource.data.caption.size() <= 200);
      allow delete: if isOwner(uid);
    }

    // Journal subcollection under trips
    match /users/{uid}/trips/{tripId}/journal/{journalId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasOnly([
                         'title', 'description', 'date', 'imageUrl',
                         'imageStoragePath', 'createdAt'
                       ])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 150
                    && (!('description' in request.resource.data) || request.resource.data.description == null || request.resource.data.description.size() <= 5000);
      allow update: if isOwner(uid)
                    && request.resource.data.keys().hasOnly([
                         'title', 'description', 'date', 'imageUrl',
                         'imageStoragePath', 'createdAt'
                       ])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 150
                    && (!('description' in request.resource.data) || request.resource.data.description == null || request.resource.data.description.size() <= 5000);
      allow delete: if isOwner(uid);
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
